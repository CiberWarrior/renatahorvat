# Copy this file to .env for local development.
# Never commit .env. Production secrets go in the Vercel project settings.

# Required for the contact form (https://resend.com)
RESEND_API_KEY=your_resend_key

# Optional overrides (production currently hardcodes these in api/contact.js)
CONTACT_TO=you@example.com
CONTACT_FROM="Renata Website <no-reply@renatahorvat.com>"

# Optional: practice SMS endpoint at /api/sms-test (off until all are set)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# SMS_TEST_ALLOWED=+385981234567
# SMS_TEST_MODE=custom
