---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactCta from '../components/ContactCta.astro';
import HeadingIcon from '../components/HeadingIcon.astro';
import { pricesContent } from '../i18n/prices';
import { getLocale, pageHref } from '../i18n/utils';

const locale = getLocale(Astro.url);
const c = pricesContent[locale];

// Each package has a defined scope (pages, rounds of changes), so the price stays predictable.
// Texts and prices come from src/i18n/prices.ts; analytics names and the highlight stay the same in every language.
const packageMeta = [
  { cta: 'pricing_project_page', common: false },
  { cta: 'pricing_society', common: true },
  { cta: 'pricing_institutional', common: false },
];
const packages = c.packages.map((pkg, i) => ({ ...pkg, ...packageMeta[i] }));
---

<Layout
  title={c.title}
  description={c.description}
  keywords={c.keywords}
>
  <Header />

  <!-- Intro -->
  <section class="border-b border-rule py-14 sm:py-16">
    <div class="mx-auto max-w-6xl space-y-5 px-4 sm:px-6">
      <p class="font-mono text-xs uppercase tracking-[.08em] text-ink-soft">{c.eyebrow}</p>
      <h1 class="max-w-3xl font-serif text-4xl font-medium leading-tight text-balance text-ink sm:text-5xl">
        {c.heading}
      </h1>
      <p class="max-w-2xl text-[15px] leading-relaxed text-ink-soft">
        {c.intro}
      </p>
    </div>
  </section>

  <!-- Packages -->
  <section class="pb-14 pt-12 sm:pb-16 sm:pt-14" aria-labelledby="packages-heading">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 id="packages-heading" class="sr-only">{c.packagesHeading}</h2>
      <div class="grid gap-8 md:grid-cols-3 md:gap-6">
        {packages.map((pkg) => (
          <article class={`relative flex min-w-0 flex-col gap-4 rounded-2xl border p-6 sm:p-7 ${pkg.common ? 'border-sci bg-surface/70 shadow-[0_24px_40px_-30px_rgb(21_33_30/.55)] ring-1 ring-sci/25' : 'border-rule bg-surface/50'}`}>
            {pkg.common && (
              <span class="absolute -top-3 left-6 rounded-full bg-sci px-3 py-1 font-mono text-[11px] uppercase tracking-[.06em] text-white">{c.mostCommon}</span>
            )}
            <h3 class="font-serif text-2xl font-medium leading-tight text-ink md:min-h-[3.5rem]">{pkg.name}</h3>
            <p class="text-[15px] leading-relaxed text-ink-soft md:min-h-[4.5rem]">{pkg.for}</p>
            <div class="border-t border-rule pt-4">
              <p class="font-serif text-5xl leading-none text-ink">
                <span class="font-text text-base text-ink-soft">{c.from}</span>{pkg.price}
              </p>
              <p class="mt-3 inline-block rounded-full bg-sci-soft px-3 py-1 font-mono text-xs uppercase tracking-[.06em] text-sci">{pkg.pages}</p>
            </div>
            <a
              href={pageHref('/contact', locale)}
              class={`group mt-auto inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md px-5 py-3 font-medium transition-colors ${pkg.common ? 'bg-sci text-white hover:bg-sci-dark' : 'border border-rule bg-surface text-ink hover:border-sci hover:text-sci'}`}
              onclick={`if(typeof window.gtag !== 'undefined') window.gtag('event', 'cta_click', { cta_type: '${pkg.cta}', cta_location: 'prices_page' })`}
            >
              {c.quote} <span class="inline-block transition-transform duration-300 group-hover:translate-x-1 motion-reduce:transition-none" aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
      <p class="mt-8 max-w-2xl text-[15px] leading-relaxed text-ink-soft">{c.priceNote}</p>
    </div>
  </section>

  <!-- Comparison -->
  <section class="border-t border-rule py-14 sm:py-16" aria-labelledby="compare-heading">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 id="compare-heading" class="group mb-8 flex items-center gap-4 font-serif text-3xl font-medium text-ink sm:text-4xl"><HeadingIcon name="umbrella" />{c.compareHeading}</h2>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[560px] border-collapse text-left text-[15px]">
          <thead>
            <tr class="border-b border-ink">
              <th scope="col" class="py-3 pr-4 font-mono text-[11px] font-normal uppercase tracking-[.08em] text-ink-soft"><span class="sr-only">{c.featureColumn}</span></th>
              {packages.map((pkg) => (
                <th scope="col" class="px-3 py-3 font-serif text-base font-medium text-ink">{pkg.name}<span class="mt-0.5 block font-text text-sm font-normal text-ink-soft">{c.from}{pkg.price}</span></th>
              ))}
            </tr>
          </thead>
          <tbody>
            {c.rows.map((row) => (
              <tr class="border-b border-rule">
                <th scope="row" class="py-3 pr-4 font-normal text-ink">{row.label}</th>
                {row.values.map((v) => (
                  <td class="px-3 py-3">
                    {typeof v === 'string' ? (
                      <span class="text-ink">{v}</span>
                    ) : v ? (
                      <span class="text-sci" aria-label={c.included}>✓</span>
                    ) : (
                      <span class="text-ink-soft/50" aria-label={c.notIncluded}>–</span>
                    )}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {c.notes.map((note, i) => (
        <p class={`${i === 0 ? 'mt-6' : 'mt-3'} text-[15px] text-ink-soft`}>
          {note}
        </p>
      ))}
    </div>
  </section>

  <!-- Projects quoted individually -->
  <section class="border-t border-rule py-14 sm:py-16" aria-labelledby="scoped-heading">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="mb-8 max-w-2xl space-y-3">
        <h2 id="scoped-heading" class="font-serif text-3xl font-medium text-ink sm:text-4xl">{c.scopedHeading}</h2>
        <p class="text-ink-soft">{c.scopedIntro}</p>
      </div>
      <div class="grid border-t border-ink md:grid-cols-3">
        {c.scoped.map((item, i) => (
          <div class={`grid min-w-0 content-start gap-3 border-b border-rule py-6 md:border-b-0 ${i % 3 > 0 ? 'md:border-l md:border-rule md:pl-8' : ''} ${i % 3 < 2 ? 'md:pr-8' : ''}`}>
            <h3 class="font-serif text-xl font-medium text-ink">{item.name}</h3>
            <p class="text-[15px] leading-relaxed text-ink-soft">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- After launch -->
  <section class="border-t border-rule py-14 sm:py-16" aria-labelledby="after-heading">
    <div class="mx-auto grid max-w-6xl gap-6 px-4 sm:px-6 md:grid-cols-[1fr_1.2fr] md:gap-16">
      <div class="space-y-3">
        <h2 id="after-heading" class="font-serif text-3xl font-medium text-ink sm:text-4xl">{c.afterHeading}</h2>
        <p class="text-ink-soft">{c.afterText}</p>
      </div>
      <ul class="list-disc space-y-2 pl-5 text-[15px] text-ink marker:text-sci md:self-center">
        {c.afterLaunch.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <!-- How to get a quote -->
  <section class="border-t border-rule py-14 sm:py-16" aria-labelledby="steps-heading">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 id="steps-heading" class="group mb-8 flex items-center gap-4 font-serif text-3xl font-medium text-ink sm:text-4xl"><HeadingIcon name="rocket" />{c.stepsHeading}</h2>
      <ol class="grid gap-8 border-t border-ink pt-6 md:grid-cols-3 md:gap-0">
        {c.steps.map((step, i) => (
          <li class={`min-w-0 ${i > 0 ? 'md:border-l md:border-rule md:pl-8' : ''} ${i < c.steps.length - 1 ? 'md:pr-8' : ''}`}>
            <p class="font-mono text-sm text-sci">{c.step} {i + 1}</p>
            <h3 class="mt-1 font-serif text-xl font-medium text-ink">{step.title}</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-ink-soft">{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <ContactCta
    location="prices_bottom"
    heading={c.ctaHeading}
    text=""
    button={c.ctaButton}
    href={pageHref('/quiz', locale)}
  />

  <Footer />
</Layout>
