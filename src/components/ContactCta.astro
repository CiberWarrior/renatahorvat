---
// Closing call to action used at the bottom of pages: text on the left, two buttons on the right
// (a message and the quiz). On the pricing page the quiz comes first (quizFirst). On phones the buttons stack.
// With `illustration` (home page) the buttons sit under the text and the diatom drawing takes the right side.
import DiatomLong from './DiatomLong.astro';
import { getLocale, pageHref, useTranslations } from '../i18n/utils';

interface Props { heading?: string; text?: string; button?: string; href?: string; location: string; quizFirst?: boolean; illustration?: boolean; }
const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const {
  heading = t('cta.heading'),
  text = t('cta.text'),
  button = t('cta.button'),
  href = pageHref('/contact', locale),
  location,
  quizFirst = false,
  illustration = false,
} = Astro.props as Props;
const track = (cta: string) => `if(typeof window.gtag !== 'undefined') window.gtag('event', 'cta_click', { cta_type: '${cta}', cta_location: '${location}' })`;
const mainClass = 'cta-main order-first group inline-flex items-center justify-center gap-2.5 rounded-full bg-paper py-3 pl-4 pr-5 font-medium text-ink transition-colors hover:bg-sci-soft';
const secondClass = 'group inline-flex items-center justify-center gap-2.5 rounded-full border border-paper/30 py-3 pl-4 pr-5 font-medium text-paper transition-colors hover:border-paper/70 hover:bg-paper/5';
---

<section class="relative overflow-hidden bg-ink py-16 text-paper sm:py-20" aria-labelledby={`cta-heading-${location}`}>
  <div class="cta-texture pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class:list={['relative mx-auto grid max-w-6xl items-center gap-8 px-4 sm:px-6 md:gap-16', illustration ? 'md:grid-cols-[1.2fr_1fr] md:gap-y-8' : 'md:grid-cols-[1.3fr_1fr]']}>
    <div class="grid gap-4">
      <h2 id={`cta-heading-${location}`} class="font-serif text-4xl font-medium leading-tight text-balance sm:text-5xl">{heading}</h2>
      {text && <p class="max-w-lg text-[15px] leading-relaxed text-pretty text-paper/75">{text}</p>}
    </div>

    {illustration && (
      <div class="order-last mx-auto w-full max-w-[340px] md:order-none md:col-start-2 md:row-span-2 md:row-start-1 md:ml-auto md:mr-0">
        <DiatomLong tone="dark" />
      </div>
    )}

    <div class:list={['flex flex-col gap-3 sm:flex-row', illustration ? 'md:col-start-1 md:row-start-2 md:-mt-2' : 'md:justify-end']}>
      <a href={pageHref('/quiz', locale)} class={quizFirst ? mainClass : secondClass} onclick={track('quiz')}>
        <svg viewBox="0 0 24 28" class="h-5 w-5" aria-hidden="true" focusable="false">
          <path class="cta-bulb" d="M12 2.2a6.2 6.2 0 0 0-3.6 11.2c.5.4.8 1 .8 1.6v1.2h5.6v-1.2c0-.6.3-1.2.8-1.6A6.2 6.2 0 0 0 12 2.2Z" />
          <path d="M9.2 18.4h5.6M10 21.1h4M10.7 23.4h2.6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          <path d="M12 7.4v3.2M10.3 9.4c.5.6 1.1.9 1.7.9s1.2-.3 1.7-.9" fill="none" stroke="#00c9df" stroke-width="1.4" stroke-linecap="round" />
        </svg>
        {t('nav.start')}
        {quizFirst && <span class="inline-block transition-transform duration-300 group-hover:translate-x-1 motion-reduce:transition-none" aria-hidden="true">→</span>}
      </a>
      <a href={href} class={quizFirst ? secondClass : mainClass} onclick={track('get_in_touch')}>
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <rect x="3" y="5.5" width="18" height="13" rx="2" />
          <path class="cta-envelope-flap" d="m3.8 7 8.2 6 8.2-6" stroke-linecap="round" />
        </svg>
        {button}
        {!quizFirst && <span class="inline-block transition-transform duration-300 group-hover:translate-x-1 motion-reduce:transition-none" aria-hidden="true">→</span>}
      </a>
    </div>
  </div>
</section>

<style>
  /* A faint dot grid that fades out, with a soft glow in the logo colours behind the buttons */
  .cta-texture {
    background:
      radial-gradient(30rem 18rem at 80% 50%, #4338ff2e, transparent 70%),
      radial-gradient(22rem 14rem at 95% 100%, #00cedf24, transparent 70%),
      radial-gradient(circle, #f6f4ee1f 1px, transparent 1.4px) 0 0 / 22px 22px;
    mask-image: linear-gradient(90deg, transparent 0%, #000 55%);
  }
  .cta-main { box-shadow: 0 12px 30px -16px #00cedf; }
  .cta-bulb {
    fill: #d9ccf6;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linejoin: round;
    animation: cta-glow 2.4s ease-in-out infinite alternate;
  }
  @keyframes cta-glow {
    to { fill: #00cddd; }
  }
  .cta-envelope-flap { transition: d .3s; }
  .group:hover .cta-envelope-flap { d: path('m3.8 7 8.2 4 8.2-4'); }
  @media (prefers-reduced-motion: reduce) {
    .cta-bulb { animation: none; }
  }
</style>
