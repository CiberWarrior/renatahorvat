---
const hideMessageLink = Astro.url.pathname.replace(/\/$/, '') === '/contact';
---

<footer class="border-t border-rule bg-paper font-text text-ink">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="font-serif text-2xl font-medium">Renata Horvat</p>
        <p class="mt-2 max-w-md text-ink-soft">Web design and development from Zagreb, for conferences, societies, universities and small businesses.</p>
      </div>
      {!hideMessageLink && (
        <div class="flex flex-col gap-1 text-[15px] md:items-end">
          <a href="/contact" class="font-medium text-sci hover:text-sci-dark">Send a message →</a>
          <a href="mailto:screatives.info@gmail.com" class="break-all text-ink-soft hover:text-sci">screatives.info@gmail.com</a>
        </div>
      )}
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t border-rule pt-6 text-sm text-ink-soft md:flex-row md:items-center md:justify-between">
      <p>© {new Date().getFullYear()} Renata Horvat · Zagreb</p>
      <div class="flex flex-wrap items-center gap-4">
        <a href="/privacy-policy" class="hover:text-sci">Privacy Policy</a>
        <a href="/legal" class="hover:text-sci">Legal Notice</a>
        <button id="footer-cookie-settings" class="cursor-pointer hover:text-sci">Cookie Settings</button>
      </div>
    </div>
  </div>
</footer>

<script>
  // Cookie Settings button in footer
  document.addEventListener('DOMContentLoaded', function() {
    const footerCookieBtn = document.getElementById('footer-cookie-settings');
    
    if (footerCookieBtn) {
      footerCookieBtn.addEventListener('click', function() {
        // Trigger the cookie settings banner
        const cookieBanner = document.getElementById('cookie-consent-banner');
        const settingsTrigger = document.getElementById('cookie-settings-trigger');
        
        if (cookieBanner && settingsTrigger) {
          cookieBanner.classList.remove('hidden');
          settingsTrigger.classList.add('hidden');
          
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      });
    }
  });
</script>
