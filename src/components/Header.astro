---
const navItems = [
  { href: "/", label: "Home" },
  { href: "/work", label: "Work" },
  { href: "/prices", label: "Pricing" },
  { href: "/contact", label: "Contact" },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="sticky top-0 z-50 border-b border-rule bg-paper/95 font-text text-ink backdrop-blur">
  <nav class="mx-auto max-w-6xl px-4 py-4 sm:px-6" aria-label="Main">
    <div class="flex items-center justify-between gap-4">
      <a href="/" class="font-serif text-xl font-medium text-ink no-underline" onclick="if(typeof window.gtag !== 'undefined') window.gtag('event', 'logo_click', { logo_location: 'header' })">
        Renata Horvat
      </a>

      <!-- Desktop Navigation -->
      <ul class="hidden items-center gap-7 md:flex">
        {navItems.map((item) => {
          const isActive = item.href === '/'
            ? currentPath === '/'
            : currentPath.startsWith(item.href);
          return (
            <li>
              <a
                href={item.href}
                aria-current={isActive ? 'page' : undefined}
                class={`text-[15px] underline-offset-[6px] transition-colors hover:text-sci ${isActive ? 'text-ink underline decoration-sci decoration-2' : 'text-ink-soft'}`}
                onclick={`if(typeof window.gtag !== 'undefined') window.gtag('event', 'navigation_click', { nav_item: '${item.label}', nav_location: 'desktop_header' })`}
              >
                {item.label}
              </a>
            </li>
          );
        })}
        <li>
          <a href="/contact" class="rounded-md bg-sci px-4 py-2 text-[15px] font-medium text-white transition-colors hover:bg-sci-dark">Start a project</a>
        </li>
      </ul>

      <!-- Mobile menu button -->
      <button
        class="rounded p-2 text-ink md:hidden"
        id="mobile-menu-button"
        aria-label="Toggle mobile navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>

    <!-- Mobile menu -->
    <div class="mt-3 hidden border-t border-rule pt-2 md:hidden" id="mobile-menu" aria-label="Mobile navigation">
      <ul>
        {navItems.map((item) => {
          const isActiveMobile = item.href === '/'
            ? currentPath === '/'
            : currentPath.startsWith(item.href);
          return (
            <li>
              <a
                href={item.href}
                aria-current={isActiveMobile ? 'page' : undefined}
                class={`mobile-nav-link block py-3 text-base ${isActiveMobile ? 'font-medium text-sci' : 'text-ink'}`}
                onclick={`if(typeof window.gtag !== 'undefined') window.gtag('event', 'navigation_click', { nav_item: '${item.label}', nav_location: 'mobile_header' })`}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </nav>
</header>

<script>
      // Mobile menu toggle
      document.addEventListener('DOMContentLoaded', function() {
        const button = document.getElementById('mobile-menu-button');
        const menu = document.getElementById('mobile-menu');
        
        if (button && menu) {
          button.addEventListener('click', function() {
            const isHidden = menu.classList.contains('hidden');
            menu.classList.toggle('hidden');
            button.setAttribute('aria-expanded', isHidden ? 'true' : 'false');
            if (isHidden) {
              const firstLink = menu.querySelector('.mobile-nav-link');
              if (firstLink instanceof HTMLElement) firstLink.focus();
            } else {
              (button as HTMLElement).focus();
            }
          });

          // Auto-close menu when a link is clicked
          menu.querySelectorAll('.mobile-nav-link').forEach((link) => {
            link.addEventListener('click', function() {
              menu.classList.add('hidden');
              button.setAttribute('aria-expanded', 'false');
              (button as HTMLElement).focus();
            });
          });

          // Close on Escape for keyboard users
          document.addEventListener('keydown', function(e) {
            if (e.key !== 'Escape') return;
            if (menu.classList.contains('hidden')) return;
            menu.classList.add('hidden');
            button.setAttribute('aria-expanded', 'false');
            (button as HTMLElement).focus();
          });
        }
      });
</script>
