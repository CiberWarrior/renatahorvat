---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { contactContent } from "../i18n/contact";
import { getLocale, localizePath, pageHref, useTranslations } from "../i18n/utils";
import { getWhatsappUrl } from "../lib/contact";

const locale = getLocale(Astro.url);
const c = contactContent[locale];
const t = useTranslations(locale);
const pagePath = (path: string) => new URL(localizePath(path, locale), Astro.site).href;

// SEO optimized page data
const pageTitle = c.title;
const pageDescription = c.description;
const pageKeywords = c.keywords;

// Structured data for contact page
const contactStructuredData = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": c.schemaName,
  "description": pageDescription,
  "url": pagePath('/contact'),
  "mainEntity": {
    "@type": "Person",
    "@id": "https://renatahorvat.com/#person",
    "name": "Renata Horvat",
    "email": "screatives.info@gmail.com",
    "jobTitle": c.schemaJobTitle,
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Zagreb",
      "addressCountry": "HR"
    }
  }
};

const contactBreadcrumbs = [
  { name: t('nav.home'), url: locale === 'hr' ? pagePath('/') : "https://renatahorvat.com" },
  { name: t('nav.contact'), url: pagePath('/contact') }
];
const whatsappUrl = getWhatsappUrl(locale);
---


<Layout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  structuredData={contactStructuredData}
  breadcrumbs={contactBreadcrumbs}
>
  <Header />

  <!-- Intro -->
  <section class="border-b border-rule py-14 sm:py-16">
    <div class="mx-auto max-w-6xl space-y-5 px-4 sm:px-6">
      <p class="font-mono text-xs uppercase tracking-[.08em] text-ink-soft">{c.eyebrow}</p>
      <h1 class="max-w-3xl font-serif text-4xl font-medium leading-tight text-balance text-ink sm:text-5xl">
        {c.heading}
      </h1>
      <p class="max-w-2xl text-lg leading-relaxed text-ink-soft">
        {c.intro}
      </p>
    </div>
  </section>

  <section class="py-14 sm:py-16" aria-label={c.formLabel}>
    <div class="mx-auto grid max-w-6xl gap-12 px-4 sm:px-6 lg:grid-cols-[minmax(0,1fr)_280px] lg:gap-16">
      <div class="min-w-0 max-w-2xl">
        <!-- Success Message (hidden by default) -->
        <div id="success-message" class="mb-6 hidden rounded-md border border-sci/30 bg-sci-soft p-4" role="status">
          <div class="flex items-start gap-3">
            <svg class="mt-0.5 h-7 w-7 shrink-0 text-sci" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10" pathLength="1" class="dr" />
              <path d="M7.5 12.5l3.2 3.2L16.8 9.4" pathLength="1" class="dr" style="--d:.45s" />
            </svg>
            <div>
              <h2 class="font-medium text-ink">{c.successTitle}</h2>
              <p class="mt-1 text-sm text-ink-soft">{c.successText}</p>
            </div>
          </div>
        </div>

        <!-- Error Message (hidden by default) -->
        <div id="error-message" class="mb-6 hidden rounded-md border border-red-300 bg-red-50 p-4" role="alert">
          <h2 class="font-medium text-red-800">{c.errorTitle}</h2>
          <p class="mt-1 text-sm text-red-800" id="error-text">{c.script.tryAgain}</p>
        </div>

        <form id="contact-form" class="space-y-6" novalidate data-messages={JSON.stringify(c.script)}>
          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label for="name" class="mb-1.5 block text-sm font-medium text-ink">{c.nameLabel} <span class="text-allele">*</span></label>
              <input type="text" id="name" name="name" autocomplete="name" class="w-full rounded-md border border-rule bg-surface px-4 py-3 text-ink placeholder:text-ink-soft/70 focus:border-sci focus:outline-none focus:ring-2 focus:ring-sci/20" placeholder={c.namePlaceholder} aria-describedby="name-error" />
              <div id="name-error" class="mt-1 hidden text-sm text-red-700" role="alert"></div>
            </div>
            <div>
              <label for="email" class="mb-1.5 block text-sm font-medium text-ink">{c.emailLabel} <span class="text-allele">*</span></label>
              <input type="email" id="email" name="email" autocomplete="email" class="w-full rounded-md border border-rule bg-surface px-4 py-3 text-ink placeholder:text-ink-soft/70 focus:border-sci focus:outline-none focus:ring-2 focus:ring-sci/20" placeholder={c.emailPlaceholder} aria-describedby="email-error" />
              <div id="email-error" class="mt-1 hidden text-sm text-red-700" role="alert"></div>
            </div>
          </div>

          <div>
            <p class="mb-1.5 block text-sm font-medium text-ink" id="project-type-label">{c.typeLabel} <span class="font-normal text-ink-soft">{c.optional}</span></p>
            <input type="hidden" id="project-type" name="project_type" value="" />
            <div class="flex flex-wrap gap-2" role="group" aria-labelledby="project-type-label">
              {c.types.map((tag) => (
                <button type="button" class="project-tag rounded-full border border-rule bg-surface px-3.5 py-1.5 text-sm text-ink transition-colors hover:border-sci" data-value={tag.value}>
                  {tag.label}
                </button>
              ))}
            </div>
          </div>

          <div>
            <div class="flex items-baseline justify-between">
              <label for="message" class="mb-1.5 block text-sm font-medium text-ink">{c.messageLabel} <span class="text-allele">*</span></label>
              <span id="message-counter" class="text-xs text-ink-soft">0 / 1000</span>
            </div>
            <textarea id="message" name="message" maxlength="1000" rows="6" class="w-full rounded-md border border-rule bg-surface px-4 py-3 text-ink placeholder:text-ink-soft/70 focus:border-sci focus:outline-none focus:ring-2 focus:ring-sci/20 resize-y" placeholder={c.messagePlaceholder} aria-describedby="message-error"></textarea>
            <div id="message-error" class="mt-1 hidden text-sm text-red-700" role="alert"></div>
          </div>

          <div>
            <div class="flex items-start gap-3">
              <input type="checkbox" id="gdpr-consent" name="gdpr_consent" class="mt-1 h-4 w-4 rounded border-rule text-sci focus:ring-sci" />
              <label for="gdpr-consent" class="text-sm leading-relaxed text-ink-soft">
                {c.consentBefore}<a href={pageHref('/privacy-policy', locale)} target="_blank" class="text-sci underline underline-offset-2">{c.consentLink}</a>{c.consentAfter}<span class="text-allele">*</span>
              </label>
            </div>
            <div id="gdpr-error" class="mt-1 hidden text-sm text-red-700" role="alert"></div>
          </div>

          <!-- Honeypot (spam protection - hidden field) -->
          <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />

          <button type="submit" id="submit-button" class="group inline-flex items-center justify-center rounded-md bg-sci px-6 py-3 font-medium text-white transition-colors hover:bg-sci-dark disabled:opacity-60">
            <span id="button-text">{c.submit} <span class="inline-block transition-transform duration-300 group-hover:translate-x-1 motion-reduce:transition-none" aria-hidden="true">→</span></span>
            <span id="button-loader" class="hidden">
              <svg class="mr-2 inline h-4 w-4 animate-spin align-[-2px]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
              </svg>
              {c.sending}
            </span>
          </button>
        </form>
      </div>

      <aside class="space-y-6 self-start lg:sticky lg:top-24">
        <div class="rounded-lg border border-sci/40 bg-sci-soft p-5">
          <h2 class="font-serif text-xl font-medium text-ink">{c.directHeading}</h2>
          <div class="mt-4 space-y-3">
            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="group flex items-center justify-between gap-3 rounded-md bg-sci px-4 py-3 font-medium text-white transition-colors hover:bg-sci-dark" onclick="if(typeof window.gtag !== 'undefined') window.gtag('event', 'cta_click', { cta_type: 'whatsapp', cta_location: 'contact_aside' })">
              <span>{c.whatsapp}</span>
              <span class="inline-block transition-transform duration-300 group-hover:translate-x-1 motion-reduce:transition-none" aria-hidden="true">↗</span>
            </a>
            <a href="mailto:screatives.info@gmail.com" class="block break-all rounded-md border border-sci/40 bg-surface px-4 py-3 text-ink transition-colors hover:border-sci hover:text-sci">
              <span class="block font-mono text-[11px] uppercase tracking-[.08em] text-ink-soft">{c.email}</span>
              screatives.info@gmail.com
            </a>
          </div>
        </div>
        <div class="space-y-5 border-l border-rule pl-5 text-[15px]">
          <div>
            <h2 class="font-mono text-xs uppercase tracking-[.08em] text-ink-soft">{c.responseHeading}</h2>
            <p class="mt-1 text-ink">{c.responseText}</p>
          </div>
          <div>
            <h2 class="font-mono text-xs uppercase tracking-[.08em] text-ink-soft">{c.firstHeading}</h2>
            <p class="mt-1 text-ink">{c.firstText}</p>
          </div>
        </div>
      </aside>
    </div>
  </section>

    <script>
      declare global {
        interface Window {
          gtag?: (...args: unknown[]) => void;
        }
      }

      document.addEventListener('DOMContentLoaded', function () {
        // Typed element references
        const form = document.getElementById('contact-form') as HTMLFormElement | null;
        const submitButton = document.getElementById('submit-button') as HTMLButtonElement | null;
        const buttonText = document.getElementById('button-text') as HTMLElement | null;
        const buttonLoader = document.getElementById('button-loader') as HTMLElement | null;
        const successMessage = document.getElementById('success-message') as HTMLElement | null;
        const errorMessage = document.getElementById('error-message') as HTMLElement | null;
        const errorText = document.getElementById('error-text') as HTMLElement | null;
        const nameInput = document.getElementById('name') as HTMLInputElement | null;
        const emailInput = document.getElementById('email') as HTMLInputElement | null;
        const messageInput = document.getElementById('message') as HTMLTextAreaElement | null;
        const nameError = document.getElementById('name-error') as HTMLElement | null;
        const emailError = document.getElementById('email-error') as HTMLElement | null;
        const messageError = document.getElementById('message-error') as HTMLElement | null;
        const gdprError = document.getElementById('gdpr-error') as HTMLElement | null;
        const gdprCheckbox = document.getElementById('gdpr-consent') as HTMLInputElement | null;
        const messageCounter = document.getElementById('message-counter') as HTMLElement | null;

        if (!form || !submitButton) return;

        // Texts for the current language (written by the page into data-messages)
        const m = JSON.parse(form.dataset.messages || '{}') as Record<string, string | boolean>;

        // Project type tag selection
        const projectTypeTags = document.querySelectorAll<HTMLButtonElement>('.project-tag');
        const projectTypeInput = document.getElementById('project-type') as HTMLInputElement | null;

        projectTypeTags.forEach((tag) => {
          tag.addEventListener('click', () => {
            const isActive = tag.classList.contains('tag-active');
            projectTypeTags.forEach((t) => {
              t.classList.remove('tag-active', 'border-sci', 'bg-sci-soft', 'text-sci');
              t.classList.add('border-rule', 'bg-surface', 'text-ink');
            });
            if (!isActive) {
              tag.classList.add('tag-active', 'border-sci', 'bg-sci-soft', 'text-sci');
              tag.classList.remove('border-rule', 'bg-surface', 'text-ink');
              if (projectTypeInput) projectTypeInput.value = tag.dataset.value || '';
            } else {
              if (projectTypeInput) projectTypeInput.value = '';
            }
          });
        });

        // Validation functions
        const validateName = (value: string): string => {
          if (!value || !value.trim()) {
            return m.nameRequired as string;
          }
          if (value.trim().length < 2) {
            return m.nameShort as string;
          }
          return '';
        };

        const validateEmail = (value: string): string => {
          if (!value || !value.trim()) {
            return m.emailRequired as string;
          }
          const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
          if (!emailRegex.test(value)) {
            return m.emailInvalid as string;
          }
          return '';
        };

        const validateMessage = (value: string): string => {
          if (!value || !value.trim()) {
            return m.messageRequired as string;
          }
          if (value.trim().length < 10) {
            return m.messageShort as string;
          }
          if (value.length > 1000) {
            return m.messageLong as string;
          }
          return '';
        };

        form.addEventListener('submit', async function (e) {
          e.preventDefault();
          e.stopPropagation();

          const formData = new FormData(form);

          // Honeypot check — silent reject
          if (formData.get('_gotcha')) return;

          const nameValue = formData.get('name');
          const emailValue = formData.get('email');
          const messageValue = formData.get('message');
          const name = nameValue ? String(nameValue) : '';
          const email = emailValue ? String(emailValue) : '';
          const message = messageValue ? String(messageValue) : '';
          const gdprConsent = formData.get('gdpr_consent') === 'on';
          const projectTypeValue = formData.get('project_type');
          const projectType = projectTypeValue ? String(projectTypeValue) : '';

          const nameValidation = validateName(name);
          const emailValidation = validateEmail(email);
          const messageValidation = validateMessage(message);

          let hasErrors = false;

          if (nameValidation) {
            if (nameError && nameInput) {
              nameError.textContent = nameValidation;
              nameError.classList.remove('hidden');
              nameInput.classList.add('border-red-500');
              nameInput.classList.remove('border-green-500');
            }
            hasErrors = true;
          }

          if (emailValidation) {
            if (emailError && emailInput) {
              emailError.textContent = emailValidation;
              emailError.classList.remove('hidden');
              emailInput.classList.add('border-red-500');
              emailInput.classList.remove('border-green-500');
            }
            hasErrors = true;
          }

          if (messageValidation) {
            if (messageError && messageInput) {
              messageError.textContent = messageValidation;
              messageError.classList.remove('hidden');
              messageInput.classList.add('border-red-500');
              messageInput.classList.remove('border-green-500');
            }
            hasErrors = true;
          }

          if (!gdprConsent) {
            if (gdprError) {
              gdprError.textContent = m.gdprRequired as string;
              gdprError.classList.remove('hidden');
            }
            if (gdprCheckbox) {
              gdprCheckbox.classList.add('ring-2', 'ring-red-500');
            }
            hasErrors = true;
          }

          if (hasErrors) {
            submitButton.disabled = false;
            buttonText?.classList.remove('hidden');
            buttonLoader?.classList.add('hidden');
            return;
          }

          submitButton.disabled = true;
          buttonText?.classList.add('hidden');
          buttonLoader?.classList.remove('hidden');
          successMessage?.classList.add('hidden');
          errorMessage?.classList.add('hidden');

          try {
            const response = await fetch('/api/contact', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                name,
                email,
                message,
                gdprConsent,
                projectType,
                _gotcha: (form.elements.namedItem('_gotcha') as HTMLInputElement | null)?.value ?? '',
              }),
            });

            const data = await response.json();

            if (response.ok && data.success) {
              if (successMessage) {
                successMessage.classList.remove('hidden');
                successMessage.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
              }

              form.reset();

              // Reset project type tags
              projectTypeTags.forEach((t) => {
                t.classList.remove('tag-active', 'border-sci', 'bg-sci-soft', 'text-sci');
                t.classList.add('border-rule', 'bg-surface', 'text-ink');
              });
              if (projectTypeInput) projectTypeInput.value = '';

              nameError?.classList.add('hidden');
              nameInput?.classList.remove('border-red-500', 'border-green-500');
              emailError?.classList.add('hidden');
              emailInput?.classList.remove('border-red-500', 'border-green-500');
              messageError?.classList.add('hidden');
              messageInput?.classList.remove('border-red-500', 'border-green-500');

              if (gdprError) {
                gdprError.classList.add('hidden');
                gdprCheckbox?.classList.remove('ring-2', 'ring-red-500');
              }

              if (messageCounter) {
                messageCounter.textContent = '0 / 1000';
                messageCounter.classList.remove('text-allele');
                messageCounter.classList.add('text-ink-soft');
              }

              window.gtag?.('event', 'form_submission', {
                form_type: 'contact',
                submission_status: 'success',
              });

              setTimeout(() => successMessage?.classList.add('hidden'), 10000);
            } else {
              throw new Error((m.useServerMessage && data.message) || (m.sendFailed as string));
            }
          } catch (error) {
            console.error('Form submission error:', error);
            const errorMsg =
              error instanceof Error
                ? error.message
                : (m.tryAgain as string);
            if (errorText) errorText.textContent = errorMsg;
            if (errorMessage) {
              errorMessage.classList.remove('hidden');
              errorMessage.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }

            window.gtag?.('event', 'form_submission', {
              form_type: 'contact',
              submission_status: 'error',
            });
          } finally {
            submitButton.disabled = false;
            buttonText?.classList.remove('hidden');
            buttonLoader?.classList.add('hidden');
          }
        });

        // Character counter
        if (messageInput && messageCounter) {
          const updateCounter = () => {
            const length = messageInput.value.length;
            const maxLength = messageInput.maxLength || 1000;
            messageCounter.textContent = `${length} / ${maxLength}`;
            if (length > maxLength * 0.9) {
              messageCounter.classList.add('text-allele');
              messageCounter.classList.remove('text-ink-soft');
            } else {
              messageCounter.classList.remove('text-allele');
              messageCounter.classList.add('text-ink-soft');
            }
          };
          messageInput.addEventListener('input', updateCounter);
          updateCounter();
        }

        // Real-time validation — name
        if (nameInput && nameError) {
          const applyNameValidation = () => {
            const error = validateName(nameInput.value);
            if (error) {
              nameError.textContent = error;
              nameError.classList.remove('hidden');
              nameInput.classList.add('border-red-500');
              nameInput.classList.remove('border-green-500');
            } else {
              nameError.classList.add('hidden');
              nameInput.classList.remove('border-red-500');
              nameInput.classList.add('border-green-500');
            }
          };

          nameInput.addEventListener('blur', applyNameValidation);
          nameInput.addEventListener('input', () => {
            if (nameInput.value.trim().length > 0) {
              applyNameValidation();
            } else {
              nameError.classList.add('hidden');
              nameInput.classList.remove('border-red-500', 'border-green-500');
            }
          });
        }

        // Real-time validation — email
        if (emailInput && emailError) {
          const applyEmailValidation = () => {
            const error = validateEmail(emailInput.value);
            if (error) {
              emailError.textContent = error;
              emailError.classList.remove('hidden');
              emailInput.classList.add('border-red-500');
              emailInput.classList.remove('border-green-500');
            } else {
              emailError.classList.add('hidden');
              emailInput.classList.remove('border-red-500');
              emailInput.classList.add('border-green-500');
            }
          };

          emailInput.addEventListener('blur', applyEmailValidation);
          emailInput.addEventListener('input', () => {
            if (emailInput.value.trim().length > 0) {
              applyEmailValidation();
            } else {
              emailError.classList.add('hidden');
              emailInput.classList.remove('border-red-500', 'border-green-500');
            }
          });
        }

        // Real-time validation — message
        if (messageInput && messageError) {
          const applyMessageValidation = () => {
            const error = validateMessage(messageInput.value);
            if (error) {
              messageError.textContent = error;
              messageError.classList.remove('hidden');
              messageInput.classList.add('border-red-500');
              messageInput.classList.remove('border-green-500');
            } else {
              messageError.classList.add('hidden');
              messageInput.classList.remove('border-red-500');
              messageInput.classList.add('border-green-500');
            }
          };

          messageInput.addEventListener('blur', applyMessageValidation);
          messageInput.addEventListener('input', () => {
            if (messageInput.value.trim().length > 0) {
              applyMessageValidation();
            } else {
              messageError.classList.add('hidden');
              messageInput.classList.remove('border-red-500', 'border-green-500');
            }
          });
        }

        // Real-time validation — GDPR checkbox
        if (gdprCheckbox && gdprError) {
          gdprCheckbox.addEventListener('change', () => {
            if (gdprCheckbox.checked) {
              gdprError.classList.add('hidden');
              gdprCheckbox.classList.remove('ring-2', 'ring-red-500');
            } else {
              gdprError.textContent = m.gdprRequired as string;
              gdprError.classList.remove('hidden');
              gdprCheckbox.classList.add('ring-2', 'ring-red-500');
            }
          });
        }
      });
    </script>

  <Footer />
</Layout>
