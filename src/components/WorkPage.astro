---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CaseCard from "../components/CaseCard.astro";
import ContactCta from "../components/ContactCta.astro";
import { portfolio, type ProjectCategory } from "../lib/projects";
import { projectRolesHr, projectSummariesHr, projectTitlesHr } from "../i18n/projects";
import { getLocale, localizePath, pageHref, pluralForm, useTranslations } from "../i18n/utils";
import type { UiKey } from "../i18n/ui";

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const pagePath = (path: string) => new URL(localizePath(path, locale), Astro.site).href;
const projectsLabel = (n: number) => `${n} ${t(`unit.projects.${pluralForm(locale, n)}` as UiKey)}`;


// SEO optimized page data
const pageTitle = t('work.title');
const pageDescription = t('work.description');
const pageKeywords = t('work.keywords');

// Structured data for portfolio page
const portfolioStructuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Renata Horvat Portfolio",
  "description": pageDescription,
  "url": pagePath('/work'),
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": portfolio.slice(0, 10).map((project, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "item": {
        "@type": "CreativeWork",
        "name": locale === 'hr' ? projectTitlesHr[project.title] ?? project.title : project.title,
        "description": locale === 'hr' ? projectSummariesHr[project.title] ?? project.summary : project.summary,
        "url": project.href || undefined
      }
    }))
  }
};

const featuredMeta: Record<string, UiKey> = {
  'Genetics e-book': 'meta.etextbook',
  'Bacteriology e-book': 'meta.etextbook',
  'Mirisni potpisi - Fragrant Signatures': 'meta.handbook',
  'Croatian National Diatom Collection': 'meta.collection',
  'IST 2027 - 19th International Symposium on Trichoptera': 'meta.symposium',
  'ICD11 - XI. International Congress of Dipterology': 'meta.congress',
  'Herbarium Croaticum': 'meta.collection',
  'FEPS - Federation of European Phycological Societies': 'meta.society',
  'Croatian Biological Society (HBD-SBC)': 'meta.societyCroatia',
};
const featuredOrder = [
  'Mirisni potpisi - Fragrant Signatures',
  'Bacteriology e-book',
  'ICD11 - XI. International Congress of Dipterology',
  'IST 2027 - 19th International Symposium on Trichoptera',
  'Genetics e-book',
  'Herbarium Croaticum',
];
const featuredRank = (title: string) => {
  const index = featuredOrder.indexOf(title);
  return index < 0 ? featuredOrder.length : index;
};
const featured = portfolio.flatMap((p) =>
  p.featured && p.image
    ? [{
        ...p,
        image: p.image,
        role: locale === 'hr' ? projectRolesHr[p.title] ?? p.role : p.role,
        meta: featuredMeta[p.title] ? t(featuredMeta[p.title]) : '',
      }]
    : []
).sort((a, b) => featuredRank(a.title) - featuredRank(b.title));

const groups: { category: ProjectCategory; name: string }[] = [
  { category: 'conference', name: t('work.group.conference') },
  { category: 'society', name: t('work.group.society') },
  { category: 'elearning', name: t('work.group.elearning') },
  { category: 'other', name: t('work.group.other') },
];
const grouped = groups
  .map((g) => ({ ...g, items: portfolio.filter((p) => p.category === g.category) }))
  .filter((g) => g.items.length > 0);

const host = (href: string) => {
  try {
    return new URL(href).hostname.replace(/^www\./, '');
  } catch {
    return href;
  }
};
---
<Layout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  structuredData={portfolioStructuredData}
  breadcrumbs={[
    { name: t('nav.home'), url: locale === 'hr' ? pagePath('/') : "https://renatahorvat.com" },
    { name: t('nav.work'), url: pagePath('/work') }
  ]}
>
  <Header />

  <!-- Intro -->
  <section class="border-b border-rule py-14 sm:py-16">
    <div class="mx-auto max-w-6xl space-y-5 px-4 sm:px-6">
      <p class="font-mono text-xs uppercase tracking-[.08em] text-ink-soft">{t('nav.work')} · {projectsLabel(portfolio.length)}</p>
      <h1 class="max-w-3xl font-serif text-4xl font-medium leading-tight text-balance text-ink sm:text-5xl">
        {t('work.heading')}
      </h1>
      <p class="max-w-2xl text-[15px] leading-relaxed text-ink-soft">
        {t('work.intro')}
      </p>
    </div>
  </section>

  <!-- Featured -->
  <section class="py-14 sm:py-16" aria-labelledby="featured-heading">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 id="featured-heading" class="mb-10 font-serif text-3xl font-medium text-ink sm:text-4xl">{t('work.featured')}</h2>
      <div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
        {featured.map((project) => (
          <CaseCard
            title={locale === 'hr' ? projectTitlesHr[project.title] ?? project.title : project.title}
            href={project.href}
            caseHref={project.caseStudySlug ? pageHref(`/work/${project.caseStudySlug}`, locale) : undefined}
            image={project.image}
            role={project.role}
            summary={project.summary}
            meta={project.meta}
            category={project.category}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- All projects -->
  <section class="border-t border-rule py-14 sm:py-16" aria-labelledby="all-heading">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 id="all-heading" class="mb-8 font-serif text-3xl font-medium text-ink sm:text-4xl">{t('work.all')}</h2>
      <div class="border-t border-ink">
        {grouped.map((group) => (
          <div class="grid gap-3 border-b border-rule py-6 md:grid-cols-[200px_1fr] md:gap-10">
            <h3 class="flex items-baseline gap-2 font-mono text-xs uppercase tracking-[.08em] text-ink-soft md:flex-col md:gap-1">
              <span class="text-ink">{group.name}</span>
              <span>{projectsLabel(group.items.length)}</span>
            </h3>
            <ul class="grid gap-x-10 gap-y-0.5 sm:grid-cols-2">
              {group.items.map((project) => (
                <li>
                  <a
                    href={project.caseStudySlug ? pageHref(`/work/${project.caseStudySlug}`, locale) : project.href}
                    target={project.caseStudySlug ? undefined : '_blank'}
                    rel={project.caseStudySlug ? undefined : 'noopener noreferrer'}
                    title={host(project.href)}
                    class="group flex items-baseline justify-between gap-3 rounded-sm py-1.5 text-[15px] leading-snug text-ink transition-colors hover:text-sci"
                    onclick={`if(typeof window.gtag !== 'undefined') window.gtag('event', 'project_view', { project_title: ${JSON.stringify(project.title)}, project_url: ${JSON.stringify(project.href)} })`}
                  >
                    <span>{locale === 'hr' ? projectTitlesHr[project.title] ?? project.title : project.title}</span>
                    <span class="shrink-0 text-ink-soft/60 transition-colors group-hover:text-sci" aria-hidden="true">↗</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ContactCta
    location="work_bottom"
    illustration
    heading={t('work.cta.heading')}
    text={t('work.cta.text')}
  />

  <Footer />
</Layout>
