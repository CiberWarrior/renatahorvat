---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';
import CaseCard from '../components/CaseCard.astro';
import ContactCta from '../components/ContactCta.astro';
import { projects } from '../lib/projects';
import { projectRolesHr } from '../i18n/projects';
import { getLocale, pageHref, useTranslations } from '../i18n/utils';

const locale = getLocale(Astro.url);
const t = useTranslations(locale);

const previews = [
  { title: 'IST 2027 - 19th International Symposium on Trichoptera', meta: t('meta.symposium') },
  { title: 'Mirisni potpisi - Fragrant Signatures', meta: t('meta.handbook') },
  { title: 'Croatian National Diatom Collection', meta: t('meta.collection') },
];
const previewProjects = previews.flatMap(({ title, meta }) => {
  const project = projects.find((p) => p.title === title);
  if (!project?.image) return [];
  const role = locale === 'hr' ? projectRolesHr[title] ?? project.role : project.role;
  return [{ ...project, image: project.image, role, meta }];
});

const services = (['web', 'graphic', 'ads'] as const).map((key) => ({
  title: t(`home.services.${key}.title`),
  text: t(`home.services.${key}.text`),
  items: [t(`home.services.${key}.item1`), t(`home.services.${key}.item2`), t(`home.services.${key}.item3`)],
}));

// SEO optimized page data
const pageTitle = t('home.title');
const pageDescription = t('home.description');
const pageKeywords = t('home.keywords');
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
>
  <Header />
  <!-- Layout.astro already wraps slot in <main id="main-content"> -->
  <Hero />

  <!-- Selected work -->
  <section id="work" class="scroll-mt-20 border-b border-rule py-16 sm:py-20" aria-labelledby="work-heading">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="mb-10 flex flex-wrap items-end justify-between gap-x-6 gap-y-2">
        <h2 id="work-heading" class="font-serif text-4xl font-medium text-ink sm:text-[2.6rem]">{t('home.work.heading')}</h2>
        <a href={pageHref('/work', locale)} class="group inline-flex min-h-11 items-center gap-2 text-sm font-medium text-sci hover:text-sci-dark sm:text-base">
          {t('home.work.all')} <span class="inline-block transition-transform duration-300 group-hover:translate-x-1 motion-reduce:transition-none" aria-hidden="true">→</span>
        </a>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {previewProjects.map((project) => (
          <CaseCard
            title={project.title}
            href={project.href}
            image={project.image}
            role={project.role}
            summary={project.summary}
            meta={project.meta}
            category={project.category}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="border-b border-rule bg-surface py-16 sm:py-20" aria-labelledby="services-heading">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
        <h2 id="services-heading" class="font-serif text-4xl font-medium text-ink sm:text-[2.6rem]">{t('home.services.heading')}</h2>
        <a href={pageHref('/prices', locale)} class="group font-medium text-sci hover:text-sci-dark">{t('home.services.pricing')} <span class="inline-block transition-transform duration-300 group-hover:translate-x-1 motion-reduce:transition-none" aria-hidden="true">→</span></a>
      </div>
      <p class="-mt-4 mb-8 max-w-2xl text-ink-soft">{t('home.services.intro')}</p>
      <div class="grid border-t border-ink md:grid-cols-2">
        {services.map((service, i) => (
          <div class={`grid min-w-0 content-start gap-3 border-b border-rule py-7 ${services.length % 2 === 1 && i === services.length - 1 ? 'md:col-span-2' : i % 2 === 1 ? 'md:border-l md:pl-8' : 'md:pr-8'}`}>
            <h3 class="font-serif text-2xl font-medium text-ink">{service.title}</h3>
            <p class="text-[15px] leading-relaxed text-ink-soft">{service.text}</p>
            <ul class={`list-disc space-y-1 pl-5 text-[15px] text-ink marker:text-sci ${services.length % 2 === 1 && i === services.length - 1 ? 'md:grid md:grid-cols-3 md:gap-x-8' : ''}`}>
              {service.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="scroll-mt-20 border-b border-rule py-16 sm:py-20" aria-labelledby="about-heading">
    <div class="mx-auto grid max-w-6xl items-start gap-10 px-4 sm:px-6 md:grid-cols-[180px_1fr] md:gap-16">
      <!-- Portrait -->
      <div class="flex items-center gap-5 md:flex-col md:items-start md:gap-6">
        <div class="relative h-32 w-32 shrink-0 md:h-36 md:w-36">
          <span class="absolute inset-0 translate-x-2.5 translate-y-2.5 rounded-full bg-sci-soft" aria-hidden="true"></span>
          <img
            src="/images/renatahorvat.jpg"
            alt={t('home.about.portraitAlt')}
            width="288"
            height="288"
            loading="lazy"
            decoding="async"
            class="relative h-full w-full rounded-full object-cover object-[50%_25%] ring-4 ring-paper"
          />
        </div>
        <div>
          <p class="font-serif text-xl font-medium text-ink">Renata Horvat</p>
          <p class="mt-0.5 font-mono text-xs uppercase tracking-[.06em] text-ink-soft">{t('home.about.caption')}</p>
        </div>
      </div>

      <div class="max-w-2xl space-y-5">
        <h2 id="about-heading" class="font-serif text-3xl font-medium leading-tight text-balance text-ink sm:text-4xl">
          {t('home.about.heading')}
        </h2>
        <p class="text-lg leading-relaxed text-ink">
          {t('home.about.p1')}
        </p>
        <dl class="grid grid-cols-3 gap-4 border-t border-rule pt-6">
          <div class="flex flex-col-reverse justify-end">
            <dt class="text-sm text-ink-soft">{t('home.about.years')}</dt>
            <dd class="font-serif text-3xl font-medium tabular-nums text-sci" data-count="20" data-suffix="+">20+</dd>
          </div>
          <div class="flex flex-col-reverse justify-end">
            <dt class="text-sm text-ink-soft">{t('home.about.projects')}</dt>
            <dd class="font-serif text-3xl font-medium tabular-nums text-sci" data-count="50" data-suffix="+">50+</dd>
          </div>
          <div class="flex flex-col-reverse justify-end">
            <dt class="text-sm text-ink-soft">{t('home.about.institutions')}</dt>
            <dd class="font-serif text-3xl font-medium tabular-nums text-sci" data-count="15" data-suffix="+">15+</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <ContactCta location="homepage_bottom" illustration />

  <Footer />
</Layout>
