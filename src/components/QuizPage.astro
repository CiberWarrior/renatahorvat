---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { contactContent } from '../i18n/contact';
import { getLocale, localizePath, pageHref, useTranslations } from '../i18n/utils';

const locale = getLocale(Astro.url);
const c = contactContent[locale];
const q = c.quiz;
const t = useTranslations(locale);
const pagePath = (path: string) => new URL(localizePath(path, locale), Astro.site).href;

const headingLines = q.heading.split('\n');
const breadcrumbs = [
  { name: t('nav.home'), url: locale === 'hr' ? pagePath('/') : 'https://renatahorvat.com' },
  { name: headingLines.join(' '), url: pagePath('/quiz') },
];
// Falling stars for the "message sent" celebration: [left %, size px, delay s, duration s]
const celebrationStars = [
  [6, 14, 0.15, 2.4], [14, 20, 0.5, 2.7], [22, 12, 0.3, 2.3], [31, 18, 0.8, 2.8], [40, 13, 0.05, 2.5],
  [50, 22, 0.6, 2.9], [59, 12, 0.35, 2.4], [68, 18, 0.95, 2.7], [77, 14, 0.2, 2.5], [85, 20, 0.7, 2.8],
  [93, 13, 0.45, 2.4], [27, 10, 1.1, 2.6], [72, 11, 1.2, 2.6], [47, 10, 1.3, 2.5],
];
const starPath = 'M0 -11 Q2 -11 4 -4 L11 -3 Q14 -2 10 2 L6 6 L7 12 Q7 14 3 12 L0 10 L-7 13 Q-10 14 -9 9 L-7 3 L-12 -2 Q-14 -5 -9 -5 L-4 -5Z';

---

<Layout title={q.title} description={q.description} keywords={c.keywords} breadcrumbs={breadcrumbs}>
  <Header />

  <section class="border-b border-rule py-14 sm:py-16">
    <div class="mx-auto max-w-2xl space-y-5 px-4 sm:px-6">
      <p class="font-mono text-xs uppercase tracking-[.08em] text-ink-soft">{locale === 'hr' ? 'Kviz' : 'Quiz'}</p>
      <h1 class="font-serif text-4xl font-medium leading-tight text-ink sm:text-5xl">
        {headingLines.map((line) => (
          <span class="block">{line}</span>
        ))}
      </h1>
      <p class="text-[15px] leading-relaxed text-ink-soft">{q.intro}</p>
    </div>
  </section>

  <section class="py-14 sm:py-16" aria-labelledby="quiz-heading">
    <div class="mx-auto max-w-2xl px-4 sm:px-6">
      <div id="quiz-success" class="quiz-success hidden relative overflow-hidden rounded-md border border-sci/30 bg-sci-soft px-5 pb-6 pt-4 text-center" role="status">
        <!-- Decorative celebration: an umbrella opens and the hero stars fall. -->
        <div class="quiz-celebration pointer-events-none relative mx-auto h-24 w-full" aria-hidden="true">
          <svg width="0" height="0" class="absolute" focusable="false"><defs><linearGradient id="quiz-star-gradient" x2=".4" y2="1"><stop stop-color="#bd00fa" /><stop offset=".48" stop-color="#4338ff" /><stop offset="1" stop-color="#00cedf" /></linearGradient></defs></svg>
          {celebrationStars.map(([left, size, delay, duration]) => (
            <svg viewBox="-15 -15 30 30" class="quiz-star absolute top-0" style={`left:${left}%;width:${size}px;height:${size}px;--delay:${delay}s;--duration:${duration}s`} focusable="false"><path d={starPath} fill="url(#quiz-star-gradient)" /></svg>
          ))}
          <svg viewBox="0 0 120 120" class="quiz-umbrella absolute left-1/2 top-1/2 h-20 w-20 -translate-x-1/2 -translate-y-1/2" focusable="false">
            <defs>
              <linearGradient id="quiz-umbrella-gradient" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#b08cf5" /><stop offset="1" stop-color="#7c56e8" /></linearGradient>
            </defs>
            <path d="M60 62 V96 Q60 107 51 107 Q45 107 45 100" fill="none" stroke="#15211e" stroke-width="4" stroke-linecap="round" />
            <g class="quiz-canopy">
              <path d="M10 62 A50 50 0 0 1 110 62 Q97.5 52 85 62 Q72.5 52 60 62 Q47.5 52 35 62 Q22.5 52 10 62Z" fill="url(#quiz-umbrella-gradient)" />
              <path d="M60 12 Q38 30 35 62 Q47.5 52 60 62 Q72.5 52 85 62 Q82 30 60 12Z" fill="#fff" fill-opacity=".22" />
              <circle cx="60" cy="11" r="3.2" fill="#15211e" />
            </g>
          </svg>
        </div>
        <h2 class="font-serif text-2xl font-medium text-ink">{c.successTitle}</h2>
        <p class="mt-1 text-[15px] text-ink-soft">{c.successText}</p>
      </div>

      <div id="quiz-error" class="mb-6 hidden rounded-md border border-red-300 bg-red-50 p-4" role="alert">
        <h2 class="font-medium text-red-800">{c.errorTitle}</h2>
        <p id="quiz-error-text" class="mt-1 text-sm text-red-800">{c.script.tryAgain}</p>
      </div>

      <form
        id="quiz-form"
        class="overflow-hidden rounded-xl border border-rule bg-surface"
        novalidate
        data-messages={JSON.stringify(c.script)}
        data-step={q.step}
        data-details-progress={q.detailsProgress}
        data-summary={q.summaryHeading}
        data-note-label={q.noteLabel}
        data-phone-label={q.phoneLabel}
        data-website-label={q.websiteLabel}
      >
        <div class="border-b border-rule bg-paper px-5 py-4 sm:px-6">
          <p id="quiz-progress" class="font-mono text-xs uppercase tracking-[.08em] text-ink-soft" aria-live="polite">
            {q.step.replace('{current}', '1').replace('{total}', String(q.questions.length))}
          </p>
        </div>

        {q.questions.map((question, index) => (
          <fieldset class:list={['quiz-step grid gap-4 px-5 py-6 sm:px-6', index > 0 && 'hidden']} data-step={index} data-label={question.question}>
            <legend class="sr-only">{question.question}</legend>
            <h2 id={`quiz-q-${question.id}`} tabindex="-1" class="font-serif text-2xl font-medium text-ink outline-none">
              {question.question}
            </h2>
            <div class="grid gap-2" role="radiogroup" aria-labelledby={`quiz-q-${question.id}`}>
              {question.answers.map((answer) => (
                <label class="flex cursor-pointer items-center rounded-md border border-rule bg-paper px-4 py-3 text-[15px] text-ink transition-colors hover:border-sci has-[:checked]:border-sci has-[:checked]:bg-sci-soft has-[:checked]:text-sci">
                  <input
                    type="radio"
                    class="sr-only"
                    name={question.id}
                    value={answer.label}
                    data-project-type={answer.projectType ?? ''}
                  />
                  {answer.label}
                </label>
              ))}
            </div>
          </fieldset>
        ))}

        <fieldset class="quiz-step hidden grid gap-6 px-5 py-6 sm:px-6" data-step="details">
          <legend class="sr-only">{q.detailsHeading}</legend>
          <h2 tabindex="-1" class="font-serif text-2xl font-medium text-ink outline-none">{q.detailsHeading}</h2>
          <p class="text-[15px] leading-relaxed text-ink-soft">{q.detailsIntro}</p>
          <div class="rounded-md border border-rule bg-paper px-4 py-4">
            <p class="font-mono text-xs uppercase tracking-[.08em] text-ink-soft">{q.summaryTitle}</p>
            <dl id="quiz-summary" class="mt-3 grid gap-3 text-sm"></dl>
          </div>

          <div>
            <label for="quiz-name" class="mb-1.5 block text-sm font-medium text-ink">{c.nameLabel} <span class="text-allele">*</span></label>
            <input type="text" id="quiz-name" name="name" autocomplete="name" class="w-full rounded-md border border-rule bg-paper px-4 py-3 text-ink placeholder:text-ink-soft/70 focus:border-sci focus:outline-none focus:ring-2 focus:ring-sci/20" placeholder={c.namePlaceholder} />
            <p id="quiz-name-error" class="mt-1 hidden text-sm text-red-700" role="alert"></p>
          </div>
          <div>
            <label for="quiz-email" class="mb-1.5 block text-sm font-medium text-ink">{c.emailLabel} <span class="text-allele">*</span></label>
            <input type="email" id="quiz-email" name="email" autocomplete="email" class="w-full rounded-md border border-rule bg-paper px-4 py-3 text-ink placeholder:text-ink-soft/70 focus:border-sci focus:outline-none focus:ring-2 focus:ring-sci/20" placeholder={c.emailPlaceholder} />
            <p id="quiz-email-error" class="mt-1 hidden text-sm text-red-700" role="alert"></p>
          </div>
          <div>
            <label for="quiz-phone" class="mb-1.5 block text-sm font-medium text-ink">{q.phoneLabel} <span class="font-normal text-ink-soft">{c.optional}</span></label>
            <input type="tel" id="quiz-phone" name="phone" autocomplete="tel" class="w-full rounded-md border border-rule bg-paper px-4 py-3 text-ink placeholder:text-ink-soft/70 focus:border-sci focus:outline-none focus:ring-2 focus:ring-sci/20" placeholder={q.phonePlaceholder} />
          </div>
          <div>
            <label for="quiz-website" class="mb-1.5 block text-sm font-medium text-ink">{q.websiteLabel} <span class="font-normal text-ink-soft">{c.optional}</span></label>
            <input type="url" id="quiz-website" name="website" autocomplete="url" inputmode="url" class="w-full rounded-md border border-rule bg-paper px-4 py-3 text-ink placeholder:text-ink-soft/70 focus:border-sci focus:outline-none focus:ring-2 focus:ring-sci/20" placeholder={q.websitePlaceholder} />
          </div>
          <div>
            <label for="quiz-note" class="mb-1.5 block text-sm font-medium text-ink">{q.noteLabel} <span class="font-normal text-ink-soft">{c.optional}</span></label>
            <textarea id="quiz-note" name="note" maxlength="400" rows="3" class="w-full resize-y rounded-md border border-rule bg-paper px-4 py-3 text-ink placeholder:text-ink-soft/70 focus:border-sci focus:outline-none focus:ring-2 focus:ring-sci/20" placeholder={q.notePlaceholder}></textarea>
          </div>
          <div>
            <div class="flex items-start gap-3">
              <input type="checkbox" id="quiz-gdpr" name="gdpr_consent" class="mt-1 h-4 w-4 rounded border-rule text-sci focus:ring-sci" />
              <label for="quiz-gdpr" class="text-sm leading-relaxed text-ink-soft">
                {c.consentBefore}<a href={pageHref('/privacy-policy', locale)} target="_blank" class="text-sci underline underline-offset-2">{c.consentLink}</a>{c.consentAfter}<span class="text-allele">*</span>
              </label>
            </div>
            <p id="quiz-gdpr-error" class="mt-1 hidden text-sm text-red-700" role="alert"></p>
          </div>
          <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
          <button type="submit" id="quiz-submit" class="group inline-flex w-fit items-center justify-center rounded-md bg-sci px-6 py-3 font-medium text-white transition-colors hover:bg-sci-dark disabled:opacity-60">
            <span id="quiz-button-text">{q.submit} <span class="inline-block transition-transform duration-300 group-hover:translate-x-1 motion-reduce:transition-none" aria-hidden="true">→</span></span>
            <span id="quiz-button-loader" class="hidden">{c.sending}</span>
          </button>
        </fieldset>

        <div class="border-t border-rule bg-paper px-5 py-4 sm:px-6">
          <button type="button" id="quiz-back" class="hidden text-sm font-medium text-ink-soft hover:text-sci">
            ← {q.back}
          </button>
        </div>
      </form>
    </div>
  </section>

  <Footer />

  <script>
    declare global {
      interface Window {
        gtag?: (...args: unknown[]) => void;
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('quiz-form') as HTMLFormElement | null;
      const steps = Array.from(document.querySelectorAll<HTMLElement>('.quiz-step'));
      const progress = document.getElementById('quiz-progress');
      const backButton = document.getElementById('quiz-back') as HTMLButtonElement | null;
      const summary = document.getElementById('quiz-summary');
      if (!form || steps.length === 0) return;

      const questionSteps = steps.filter((step) => step.dataset.step !== 'details');
      const detailsStep = steps.find((step) => step.dataset.step === 'details');
      const m = JSON.parse(form.dataset.messages || '{}') as Record<string, string | boolean>;
      let current = 0;

      const show = (index: number) => {
        current = index;
        const onDetails = index >= questionSteps.length;
        questionSteps.forEach((step, stepIndex) => step.classList.toggle('hidden', onDetails || stepIndex !== index));
        detailsStep?.classList.toggle('hidden', !onDetails);
        backButton?.classList.toggle('hidden', index === 0);

        if (progress) {
          const template = form.dataset.step || '';
          progress.textContent = onDetails
            ? form.dataset.detailsProgress || ''
            : template.replace('{current}', String(index + 1)).replace('{total}', String(questionSteps.length));
        }

        if (onDetails && summary) {
          summary.replaceChildren();
          questionSteps.forEach((step) => {
            const checked = step.querySelector<HTMLInputElement>('input:checked');
            if (!checked) return;
            const row = document.createElement('div');
            const question = document.createElement('dt');
            const answer = document.createElement('dd');
            question.className = 'text-ink-soft';
            question.textContent = (step.dataset.label || '').replace(/[?:]$/, '');
            answer.className = 'font-medium text-ink';
            answer.textContent = checked.value;
            row.append(question, answer);
            summary.append(row);
          });
        }

        const focusTarget = onDetails
          ? detailsStep?.querySelector<HTMLElement>('h2')
          : questionSteps[index]?.querySelector<HTMLElement>('h2');
        focusTarget?.focus();
        if (onDetails) {
          const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          form.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
        }
      };

      questionSteps.forEach((step, index) => {
        step.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach((input) => {
          const goNext = () => {
            if (current !== index) return;
            show(index < questionSteps.length - 1 ? index + 1 : questionSteps.length);
          };
          input.addEventListener('change', goNext);
          input.addEventListener('click', goNext);
        });
      });

      backButton?.addEventListener('click', () => {
        if (current > 0) show(current - 1);
      });

      const showError = (id: string, inputId: string, text: string) => {
        const error = document.getElementById(id);
        const input = document.getElementById(inputId);
        if (error) {
          error.textContent = text;
          error.classList.toggle('hidden', !text);
        }
        input?.classList.toggle('border-red-500', Boolean(text));
      };

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const data = new FormData(form);
        if (data.get('_gotcha')) return;

        const name = String(data.get('name') || '');
        const email = String(data.get('email') || '');
        const note = String(data.get('note') || '').trim();
        const phone = String(data.get('phone') || '').trim();
        const website = String(data.get('website') || '').trim();
        const gdprConsent = data.get('gdpr_consent') === 'on';
        let nameError = '';
        if (!name.trim()) nameError = m.nameRequired as string;
        else if (name.trim().length < 2) nameError = m.nameShort as string;
        let emailError = '';
        if (!email.trim()) emailError = m.emailRequired as string;
        else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) emailError = m.emailInvalid as string;

        showError('quiz-name-error', 'quiz-name', nameError);
        showError('quiz-email-error', 'quiz-email', emailError);
        const gdprError = document.getElementById('quiz-gdpr-error');
        if (gdprError) {
          gdprError.textContent = gdprConsent ? '' : (m.gdprRequired as string);
          gdprError.classList.toggle('hidden', gdprConsent);
        }
        if (nameError || emailError || !gdprConsent) return;

        const lines = [form.dataset.summary || 'Quiz'];
        let projectType = '';
        questionSteps.forEach((step) => {
          const checked = step.querySelector<HTMLInputElement>('input:checked');
          if (!checked) return;
          const label = (step.dataset.label || '').replace(/[?:]$/, '');
          lines.push(`- ${label}: ${checked.value}`);
          if (!projectType && checked.dataset.projectType) projectType = checked.dataset.projectType;
        });
        if (phone || website || note) lines.push('');
        if (phone) lines.push(`${(form.dataset.phoneLabel || '').replace(/[?:]$/, '')}: ${phone}`);
        if (website) lines.push(`${(form.dataset.websiteLabel || '').replace(/[?:]$/, '')}: ${website}`);
        if (note) lines.push(`${(form.dataset.noteLabel || '').replace(/[?:]$/, '')}: ${note}`);

        const submitButton = document.getElementById('quiz-submit') as HTMLButtonElement | null;
        const buttonText = document.getElementById('quiz-button-text');
        const buttonLoader = document.getElementById('quiz-button-loader');
        const errorBox = document.getElementById('quiz-error');
        const errorText = document.getElementById('quiz-error-text');
        if (submitButton) submitButton.disabled = true;
        buttonText?.classList.add('hidden');
        buttonLoader?.classList.remove('hidden');
        errorBox?.classList.add('hidden');

        try {
          const response = await fetch('/api/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              name,
              email,
              message: lines.join('\n'),
              gdprConsent,
              projectType,
              _gotcha: '',
            }),
          });
          const result = await response.json();
          if (!response.ok || !result.success) {
            throw new Error((m.useServerMessage && result.message) || (m.sendFailed as string));
          }
          form.classList.add('hidden');
          const successBox = document.getElementById('quiz-success');
          successBox?.classList.remove('hidden');
          successBox?.classList.add('is-celebrating');
          successBox?.scrollIntoView({
            block: 'center',
            behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
          });
          window.gtag?.('event', 'form_submission', { form_type: 'quiz', submission_status: 'success' });
        } catch (error) {
          if (errorText) {
            errorText.textContent = error instanceof Error ? error.message : (m.tryAgain as string);
          }
          errorBox?.classList.remove('hidden');
          window.gtag?.('event', 'form_submission', { form_type: 'quiz', submission_status: 'error' });
        } finally {
          if (submitButton) submitButton.disabled = false;
          buttonText?.classList.remove('hidden');
          buttonLoader?.classList.add('hidden');
        }
      });

      show(0);
    });
  </script>
</Layout>

<style>
  .quiz-star { opacity: 0; }
  .quiz-canopy { transform-box: fill-box; transform-origin: 50% 100%; }

  /* The umbrella starts closed and opens with a small bounce; stars drift down once. */
  .is-celebrating .quiz-canopy { animation: quiz-umbrella-open 0.9s cubic-bezier(0.34, 1.56, 0.64, 1) both; }
  .is-celebrating .quiz-umbrella { animation: quiz-umbrella-hop 0.9s ease-out both; }
  .is-celebrating .quiz-star { animation: quiz-star-fall var(--duration) ease-in var(--delay) both; }

  @keyframes quiz-umbrella-open { from { transform: scaleX(0.15); } to { transform: scaleX(1); } }
  @keyframes quiz-umbrella-hop { 0% { margin-top: 14px; } 55% { margin-top: -6px; } 100% { margin-top: 0; } }
  @keyframes quiz-star-fall {
    0% { opacity: 0; transform: translateY(-14px) rotate(0deg) scale(0.6); }
    15% { opacity: 1; }
    80% { opacity: 1; }
    100% { opacity: 0; transform: translateY(104px) rotate(300deg) scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .is-celebrating .quiz-canopy, .is-celebrating .quiz-umbrella { animation: none; }
    .quiz-star { display: none; }
  }
</style>
