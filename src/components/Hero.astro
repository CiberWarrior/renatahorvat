---
import HeroMagic from './HeroMagic.astro';
import { getLocale, pageHref, useTranslations } from '../i18n/utils';

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
---

<section class="border-b border-rule py-8 sm:py-12 xl:py-20">
  <div class="hero-layout mx-auto grid max-w-6xl gap-5 sm:gap-6 px-4 sm:px-6">
    <div class="hero-intro fade-up space-y-4 sm:space-y-6">
      <p class="font-mono text-xs uppercase tracking-[.08em] text-ink-soft">{t('hero.eyebrow')}</p>

      <!-- Single visible H1 for SEO and accessibility -->
      <h1 class="max-w-[13ch] font-serif text-[2.25rem] font-medium leading-[1.08] tracking-tight text-balance text-ink sm:text-5xl lg:text-6xl">
        {t('hero.titleStart')}<em class="text-sci">{t('hero.titleEmphasis')}</em>
      </h1>
    </div>

    <figure class="hero-art min-w-0">
      <HeroMagic />
      <figcaption class="mt-3 border-t border-rule pt-3 text-xs leading-relaxed text-balance text-ink-soft sm:text-sm">
        {t('hero.caption')}
      </figcaption>
    </figure>

    <div class="hero-copy fade-up space-y-4 sm:space-y-6">
      <div class="max-w-xl space-y-3 text-base leading-relaxed text-pretty text-ink-soft sm:space-y-4 sm:text-lg">
        <p>{t('hero.p1')}</p>
        <p>{t('hero.p2')}</p>
        <p>{t('hero.p3')}</p>
      </div>

      <div class="flex flex-col items-start gap-2 pt-1 sm:gap-3 sm:pt-2 sm:flex-row sm:flex-wrap sm:items-stretch">
        <a href="#work" class="group inline-flex whitespace-nowrap w-fit max-w-full min-h-11 items-center justify-center gap-2 sm:w-auto sm:max-w-none rounded-md bg-sci px-4 py-2 text-sm font-medium sm:px-6 sm:py-3 sm:text-base text-white transition-colors hover:bg-sci-dark" onclick="if(typeof window.gtag !== 'undefined') window.gtag('event', 'cta_click', { cta_type: 'view_projects', cta_location: 'hero' })">
          {t('hero.viewWork')} <span class="inline-block transition-transform duration-300 group-hover:translate-x-1 motion-reduce:transition-none" aria-hidden="true">→</span>
        </a>
        <a href={pageHref('/contact', locale)} class="group inline-flex whitespace-nowrap w-fit max-w-full min-h-11 items-center justify-center gap-2 sm:w-auto sm:max-w-none rounded-md border border-rule bg-surface px-4 py-2 text-sm font-medium sm:px-6 sm:py-3 sm:text-base text-ink transition-colors hover:border-sci" onclick="if(typeof window.gtag !== 'undefined') window.gtag('event', 'cta_click', { cta_type: 'get_in_touch', cta_location: 'hero' })">
          {t('hero.talk')} <span class="inline-block transition-transform duration-300 group-hover:translate-x-1 motion-reduce:transition-none" aria-hidden="true">→</span>
        </a>
      </div>
    </div>

  </div>
</section>

<style>
  .hero-layout { grid-template-areas: 'intro' 'art' 'copy'; }
  .hero-intro { grid-area: intro; min-width: 0; }
  .hero-copy { grid-area: copy; min-width: 0; }
  .hero-art { grid-area: art; width: 100%; margin: 0; }
  @media (min-width: 768px) {
    .hero-layout { grid-template-areas: 'intro' 'copy' 'art'; }
    .hero-art { max-width: 1040px; justify-self: center; }
  }
  @media (min-width: 1280px) {
    .hero-layout {
      grid-template-areas: 'intro art' 'copy art';
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr);
      column-gap: 2rem;
    }
    .hero-intro { align-self: end; }
    .hero-copy { align-self: start; }
    .hero-art { align-self: center; }
  }
</style>
