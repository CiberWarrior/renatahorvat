---
import HeroMagic from './HeroMagic.astro';
---

<section class="border-b border-rule py-8 sm:py-12 xl:py-20">
  <div class="hero-layout mx-auto grid max-w-[90rem] gap-6 px-4 sm:px-6">
    <div class="hero-intro fade-up space-y-6">
      <p class="font-mono text-xs uppercase tracking-[.08em] text-ink-soft">Web designer &amp; developer · Zagreb</p>

      <!-- Single visible H1 for SEO and accessibility -->
      <h1 class="font-serif text-[2.5rem] font-medium leading-[1.08] tracking-tight text-balance text-ink sm:text-5xl lg:text-6xl">
        Websites that tell <em class="text-sci">your story</em>
      </h1>
    </div>

    <figure class="hero-art min-w-0">
      <HeroMagic />
      <figcaption class="mt-3 border-t border-rule pt-3 text-sm text-ink-soft">
        From a little spark to your next big thing.
      </figcaption>
    </figure>

    <div class="hero-copy fade-up space-y-6">
      <p class="max-w-xl text-lg leading-relaxed text-ink-soft sm:text-xl">
        Web designer with over 20 years of experience. From scientific congresses to a local bike service, I design, illustrate and build clear websites, and web apps that present research.
      </p>

      <div class="flex flex-col items-start gap-3 pt-2 sm:flex-row sm:items-stretch">
        <a href="#work" class="group inline-flex w-full max-w-[18rem] items-center justify-center gap-2 sm:w-auto sm:max-w-none rounded-md bg-sci px-6 py-3 font-medium text-white transition-colors hover:bg-sci-dark" onclick="if(typeof window.gtag !== 'undefined') window.gtag('event', 'cta_click', { cta_type: 'view_projects', cta_location: 'hero' })">
          See selected work <span class="inline-block transition-transform duration-300 group-hover:translate-x-1 motion-reduce:transition-none" aria-hidden="true">→</span>
        </a>
        <a href="/contact" class="group inline-flex w-full max-w-[18rem] items-center justify-center gap-2 sm:w-auto sm:max-w-none rounded-md border border-rule bg-surface px-6 py-3 font-medium text-ink transition-colors hover:border-sci" onclick="if(typeof window.gtag !== 'undefined') window.gtag('event', 'cta_click', { cta_type: 'get_in_touch', cta_location: 'hero' })">
          Talk about a project <span class="inline-block transition-transform duration-300 group-hover:translate-x-1 motion-reduce:transition-none" aria-hidden="true">→</span>
        </a>
      </div>
    </div>

  </div>
</section>

<style>
  .hero-layout { grid-template-areas: 'intro' 'art' 'copy'; }
  .hero-intro { grid-area: intro; min-width: 0; }
  .hero-copy { grid-area: copy; min-width: 0; }
  .hero-art { grid-area: art; width: 100%; margin: 0; }
  @media (min-width: 768px) {
    .hero-layout { grid-template-areas: 'intro' 'copy' 'art'; }
    .hero-art { max-width: 1040px; justify-self: center; }
  }
  @media (min-width: 1280px) {
    .hero-layout {
      grid-template-areas: 'intro art' 'copy art';
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr);
      column-gap: 2rem;
    }
    .hero-intro { align-self: end; }
    .hero-copy { align-self: start; }
    .hero-art { align-self: center; }
  }
</style>
