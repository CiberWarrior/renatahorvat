---
import DiatomPlate from './DiatomPlate.astro';
---

<section class="border-b border-rule py-14 sm:py-20">
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 sm:px-6 lg:grid-cols-[1.15fr_1fr] lg:gap-16">
    <div class="fade-up space-y-6">
      <p class="font-mono text-xs uppercase tracking-[.08em] text-ink-soft">Web designer &amp; developer · Zagreb</p>

      <!-- Single visible H1 for SEO and accessibility -->
      <h1 class="font-serif text-[2.5rem] font-medium leading-[1.08] tracking-tight text-balance text-ink sm:text-5xl lg:text-6xl">
        Websites that tell <em class="text-sci">your story</em>
      </h1>

      <p class="max-w-xl text-lg leading-relaxed text-ink-soft sm:text-xl">
        Web designer with over 20 years of experience. From scientific congresses to a local bike service, I design, illustrate and build clear websites, and web apps that present research.
      </p>

      <div class="flex flex-col gap-3 pt-2 sm:flex-row">
        <a href="#work" class="group inline-flex items-center justify-center gap-2 rounded-md bg-sci px-6 py-3 font-medium text-white transition-colors hover:bg-sci-dark" onclick="if(typeof window.gtag !== 'undefined') window.gtag('event', 'cta_click', { cta_type: 'view_projects', cta_location: 'hero' })">
          See selected work <span class="inline-block transition-transform duration-300 group-hover:translate-x-1 motion-reduce:transition-none" aria-hidden="true">→</span>
        </a>
        <a href="/contact" class="group inline-flex items-center justify-center gap-2 rounded-md border border-rule bg-surface px-6 py-3 font-medium text-ink transition-colors hover:border-sci" onclick="if(typeof window.gtag !== 'undefined') window.gtag('event', 'cta_click', { cta_type: 'get_in_touch', cta_location: 'hero' })">
          Talk about a project <span class="inline-block transition-transform duration-300 group-hover:translate-x-1 motion-reduce:transition-none" aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <figure class="fade-up fade-up-2 rounded-lg border border-rule bg-surface p-5 sm:p-6">
      <DiatomPlate />
      <figcaption class="mt-4 border-t border-rule pt-3 text-sm text-ink-soft">
        <b class="font-mono font-medium text-ink">Fig. 1</b> Two diatom valves drawn as a line plate: a pennate form (<span class="font-mono">1a</span>) and a centric form (<span class="font-mono">1b</span>).
      </figcaption>
    </figure>
  </div>
</section>
