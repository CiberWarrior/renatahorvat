---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';
import CaseCard from '../components/CaseCard.astro';
import ContactCta from '../components/ContactCta.astro';
import { projects } from '../lib/projects';

const previews = [
  { title: 'IST 2027 - 19th International Symposium on Trichoptera', meta: 'Symposium · International · 2027' },
  { title: 'ICD11 - XI. International Congress of Dipterology', meta: 'Congress · International' },
  { title: 'Croatian National Diatom Collection', meta: 'Collection · Faculty of Science' },
];
const previewProjects = previews.flatMap(({ title, meta }) => {
  const project = projects.find((p) => p.title === title);
  return project?.image ? [{ ...project, image: project.image, meta }] : [];
});

const services = [
  {
    title: 'Conference & congress websites',
    text: 'For organising committees that need a website ready before the call for abstracts.',
    items: ['Programme and speakers', 'Registration and abstract submission', 'Venue, travel and an archive after the event'],
  },
  {
    title: 'Society & research group websites',
    text: 'Websites built to last, with news, membership information, publications and outreach.',
    items: ['Membership and events', 'Publication lists', 'Content your team can update'],
  },
  {
    title: 'E-textbooks & e-learning',
    text: 'Course materials students can use on their phones and revisit when studying.',
    items: ['Chapter structure and navigation', 'Educational diagrams in a consistent style'],
  },
  {
    title: 'Scientific figures & infographics',
    text: 'Clear visuals for papers, presentations and data, available as a standalone service or as part of a website project.',
    items: ['Publication-ready vector files', 'A consistent style across a series'],
  },
  {
    title: 'Web apps for research',
    text: 'Searchable collections, image catalogues and tools that present data and results.',
    items: ['Catalogues and databases', 'Search and filters', 'Conference tools'],
  },
];

// SEO optimized page data
const pageTitle = "Renata Horvat – Web Designer & Developer | Zagreb";
const pageDescription = "Web designer and developer in Zagreb with over 20 years of experience. Clear, fast websites for conferences, societies, universities and small businesses, from design to launch.";
const pageKeywords = "web designer Zagreb, web design Croatia, conference website, society website, university website, small business website, web developer Zagreb, Renata Horvat";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
>
  <Header />
  <!-- Layout.astro already wraps slot in <main id="main-content"> -->
  <Hero />

  <!-- Selected work -->
  <section id="work" class="scroll-mt-20 border-b border-rule py-16 sm:py-20" aria-labelledby="work-heading">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 id="work-heading" class="mb-10 font-serif text-4xl font-medium text-ink sm:text-[2.6rem]">Selected work</h2>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {previewProjects.map((project) => (
          <CaseCard
            title={project.title}
            href={project.href}
            image={project.image}
            role={project.role}
            summary={project.summary}
            meta={project.meta}
            category={project.category}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="border-b border-rule bg-surface py-16 sm:py-20" aria-labelledby="services-heading">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
        <h2 id="services-heading" class="font-serif text-4xl font-medium text-ink sm:text-[2.6rem]">What I build</h2>
        <a href="/prices" class="group font-medium text-sci hover:text-sci-dark">Pricing <span class="inline-block transition-transform duration-300 group-hover:translate-x-1 motion-reduce:transition-none" aria-hidden="true">→</span></a>
      </div>
      <p class="-mt-4 mb-8 max-w-2xl text-ink-soft">For universities, societies, conference organisers and small businesses that need a clear website.</p>
      <div class="grid border-t border-ink md:grid-cols-2">
        {services.map((service, i) => (
          <div class={`grid min-w-0 content-start gap-3 border-b border-rule py-7 ${services.length % 2 === 1 && i === services.length - 1 ? 'md:col-span-2' : i % 2 === 1 ? 'md:border-l md:pl-8' : 'md:pr-8'}`}>
            <h3 class="font-serif text-2xl font-medium text-ink">{service.title}</h3>
            <p class="text-[15px] leading-relaxed text-ink-soft">{service.text}</p>
            <ul class={`list-disc space-y-1 pl-5 text-[15px] text-ink marker:text-sci ${services.length % 2 === 1 && i === services.length - 1 ? 'md:grid md:grid-cols-3 md:gap-x-8' : ''}`}>
              {service.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="scroll-mt-20 border-b border-rule py-16 sm:py-20" aria-labelledby="about-heading">
    <div class="mx-auto grid max-w-6xl items-start gap-10 px-4 sm:px-6 md:grid-cols-[180px_1fr] md:gap-16">
      <!-- Portrait -->
      <div class="flex items-center gap-5 md:flex-col md:items-start md:gap-6">
        <div class="relative h-32 w-32 shrink-0 md:h-36 md:w-36">
          <span class="absolute inset-0 translate-x-2.5 translate-y-2.5 rounded-full bg-sci-soft" aria-hidden="true"></span>
          <img
            src="/images/renatahorvat.jpg"
            alt="Portrait of Renata Horvat"
            width="288"
            height="288"
            loading="lazy"
            decoding="async"
            class="relative h-full w-full rounded-full object-cover object-[50%_25%] ring-4 ring-paper"
          />
        </div>
        <div>
          <p class="font-serif text-xl font-medium text-ink">Renata Horvat</p>
          <p class="mt-0.5 font-mono text-xs uppercase tracking-[.06em] text-ink-soft">Zagreb · 20+ years</p>
        </div>
      </div>

      <div class="max-w-2xl space-y-5">
        <h2 id="about-heading" class="font-serif text-3xl font-medium leading-tight text-balance text-ink sm:text-4xl">
          Designing for people who work with knowledge
        </h2>
        <p class="text-lg leading-relaxed text-ink">
          I'm Renata, a web designer and developer based in Zagreb with over 20 years of experience building websites for universities, societies, congresses and small businesses.
        </p>
        <p class="leading-relaxed text-ink-soft">
          Research teams, societies and organisations come to me for websites and web apps that handle complex content, stay easy to maintain and keep serving their users long after launch.
        </p>
        <p class="leading-relaxed text-ink-soft">
          My background in science communication helps me turn complex subject matter into clear, readable and useful content.
        </p>
        <dl class="grid grid-cols-3 gap-4 border-t border-rule pt-6">
          <div>
            <dt class="text-sm text-ink-soft">Years</dt>
            <dd class="font-serif text-3xl font-medium tabular-nums text-sci" data-count="20" data-suffix="+">20+</dd>
          </div>
          <div>
            <dt class="text-sm text-ink-soft">Projects</dt>
            <dd class="font-serif text-3xl font-medium tabular-nums text-sci" data-count="50" data-suffix="+">50+</dd>
          </div>
          <div>
            <dt class="text-sm text-ink-soft">Institutions</dt>
            <dd class="font-serif text-3xl font-medium tabular-nums text-sci" data-count="15" data-suffix="+">15+</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <ContactCta location="homepage_bottom" illustration />

  <Footer />
</Layout>
