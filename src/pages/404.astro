---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Page not found | Renata Horvat" description="This page doesn't exist.">
  <Header />
  <section class="py-24 sm:py-32">
    <div class="mx-auto max-w-6xl space-y-6 px-4 sm:px-6">
      <p class="font-mono text-xs uppercase tracking-[.08em] text-ink-soft">Error 404</p>
      <h1 class="max-w-2xl font-serif text-4xl font-medium leading-tight text-balance text-ink sm:text-5xl">
        This page doesn't exist
      </h1>
      <p class="max-w-xl text-lg leading-relaxed text-ink-soft">
        The link may be outdated or the address may have been mistyped. Try one of the pages below.
      </p>
      <div class="flex flex-col gap-3 pt-2 sm:flex-row">
        <a href="/" class="inline-flex items-center justify-center rounded-md bg-sci px-6 py-3 font-medium text-white transition-colors hover:bg-sci-dark">Back to home</a>
        <a href="/work" class="inline-flex items-center justify-center rounded-md border border-rule bg-surface px-6 py-3 font-medium text-ink transition-colors hover:border-sci">View my work</a>
        <a href="/contact" class="inline-flex items-center justify-center rounded-md border border-rule bg-surface px-6 py-3 font-medium text-ink transition-colors hover:border-sci">Contact</a>
      </div>
    </div>
  </section>
  <Footer />
</Layout>
