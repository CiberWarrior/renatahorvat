---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CaseCard from "../components/CaseCard.astro";
import ContactCta from "../components/ContactCta.astro";
import { portfolio, type ProjectCategory } from "../lib/projects";

// SEO optimized page data
const pageTitle = "Work – Renata Horvat | Web Design Portfolio Croatia";
const pageDescription = "Selected projects: e-textbooks, conference websites, scientific society websites and research collections for universities and research organisations.";
const pageKeywords = "Renata Horvat portfolio, e-learning design, academic websites, scientific design, university websites, research communication, Croatia designer, Zagreb web design, educational platforms";

// Structured data for portfolio page
const portfolioStructuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Renata Horvat Portfolio",
  "description": pageDescription,
  "url": "https://renatahorvat.com/work",
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": portfolio.slice(0, 10).map((project, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "item": {
        "@type": "CreativeWork",
        "name": project.title,
        "description": project.summary,
        "url": project.href || undefined
      }
    }))
  }
};

const breadcrumbStructuredData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://renatahorvat.com" },
    { "@type": "ListItem", "position": 2, "name": "Work", "item": "https://renatahorvat.com/work" }
  ]
};

const featuredMeta: Record<string, string> = {
  'Genetika e-book': 'E-textbook · Faculty of Science',
  'Bacteriology e-book': 'E-textbook · Faculty of Science',
  'Mirisni potpisi - Fragrant Signatures': 'Handbook · Education · HR / EN',
  'Croatian National Diatom Collection': 'Collection · Faculty of Science',
  'IST 2027 - 19th International Symposium on Trichoptera': 'Symposium · International · 2027',
  'ICD11 - XI. International Congress of Dipterology': 'Congress · International',
  'Herbarium Croaticum': 'Collection · Faculty of Science',
  'FEPS - Federation of European Phycological Societies': 'Society · Europe',
};
const featured = portfolio.flatMap((p) =>
  p.featured && p.image ? [{ ...p, image: p.image, meta: featuredMeta[p.title] ?? '' }] : []
);

const groups: { category: ProjectCategory; name: string }[] = [
  { category: 'conference', name: 'Conferences & scientific events' },
  { category: 'society', name: 'Societies & collections' },
  { category: 'elearning', name: 'E-textbooks' },
  { category: 'other', name: 'Research projects & institutions' },
];
const grouped = groups
  .map((g) => ({ ...g, items: portfolio.filter((p) => p.category === g.category) }))
  .filter((g) => g.items.length > 0);

const host = (href: string) => {
  try {
    return new URL(href).hostname.replace(/^www\./, '');
  } catch {
    return href;
  }
};
---
<Layout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  structuredData={[portfolioStructuredData, breadcrumbStructuredData]}
  breadcrumbs={[
    { name: "Home", url: "https://renatahorvat.com" },
    { name: "Work", url: "https://renatahorvat.com/work" }
  ]}
>
  <Header />

  <!-- Intro -->
  <section class="border-b border-rule py-14 sm:py-16">
    <div class="mx-auto max-w-6xl space-y-5 px-4 sm:px-6">
      <p class="font-mono text-xs uppercase tracking-[.08em] text-ink-soft">Work · {portfolio.length} projects</p>
      <h1 class="max-w-3xl font-serif text-4xl font-medium leading-tight text-balance text-ink sm:text-5xl">
        Websites for universities, conferences and scientific societies
      </h1>
      <p class="max-w-2xl text-lg leading-relaxed text-ink-soft">
        Platforms for organisations that work with complex content, structured for clarity and built to last.
      </p>
    </div>
  </section>

  <!-- Featured -->
  <section class="py-14 sm:py-16" aria-labelledby="featured-heading">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 id="featured-heading" class="mb-10 font-serif text-3xl font-medium text-ink sm:text-4xl">Featured</h2>
      <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
        {featured.map((project) => (
          <CaseCard
            title={project.title}
            href={project.href}
            image={project.image}
            role={project.role}
            summary={project.summary}
            meta={project.meta}
            category={project.category}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- All projects -->
  <section class="border-t border-rule py-14 sm:py-16" aria-labelledby="all-heading">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 id="all-heading" class="mb-8 font-serif text-3xl font-medium text-ink sm:text-4xl">All projects</h2>
      <div class="border-t border-ink">
        {grouped.map((group) => (
          <div class="grid gap-3 border-b border-rule py-6 md:grid-cols-[200px_1fr] md:gap-10">
            <h3 class="flex items-baseline gap-2 font-mono text-xs uppercase tracking-[.08em] text-ink-soft md:flex-col md:gap-1">
              <span class="text-ink">{group.name}</span>
              <span>{group.items.length} projects</span>
            </h3>
            <ul class="grid gap-x-10 gap-y-0.5 sm:grid-cols-2">
              {group.items.map((project) => (
                <li>
                  <a
                    href={project.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    title={host(project.href)}
                    class="group flex items-baseline justify-between gap-3 rounded-sm py-1.5 text-[15px] leading-snug text-ink transition-colors hover:text-sci"
                    onclick={`if(typeof window.gtag !== 'undefined') window.gtag('event', 'project_view', { project_title: ${JSON.stringify(project.title)}, project_url: ${JSON.stringify(project.href)} })`}
                  >
                    <span>{project.title}</span>
                    <span class="shrink-0 text-ink-soft/60 transition-colors group-hover:text-sci" aria-hidden="true">↗</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ContactCta
    location="work_bottom"
    heading="Have a project like these?"
    text="If you're thinking about a project and want to make sense of it before building anything, send a few lines."
  />

  <Footer />
</Layout>
