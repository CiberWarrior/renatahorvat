---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="SMS test" description="Practice page" noindex>
  <Header />
  <section class="py-14 sm:py-16">
    <div class="mx-auto max-w-xl space-y-6 px-4 sm:px-6">
      <p class="font-mono text-xs uppercase tracking-[.08em] text-ink-soft">Test page · not public</p>
      <h1 class="font-serif text-4xl font-medium text-ink">SMS test</h1>
      <p class="text-ink-soft">Practice form: enter a name and a number, and a test SMS is sent through Twilio.</p>

      <form id="sms-form" class="space-y-4" novalidate>
        <label class="block text-[15px] text-ink">First name
          <input name="firstName" required autocomplete="given-name" class="mt-1 w-full rounded-md border border-rule bg-surface px-3 py-2" />
        </label>
        <label class="block text-[15px] text-ink">Last name
          <input name="lastName" required autocomplete="family-name" class="mt-1 w-full rounded-md border border-rule bg-surface px-3 py-2" />
        </label>
        <label class="block text-[15px] text-ink">Mobile number (with country code)
          <input name="phone" type="tel" required placeholder="+385981234567" autocomplete="tel" class="mt-1 w-full rounded-md border border-rule bg-surface px-3 py-2" />
        </label>
        <label class="flex items-start gap-2 text-sm text-ink-soft">
          <input name="consent" type="checkbox" class="mt-1" />
          <span>I agree to receive one test SMS on this number. The number is used only for this test.</span>
        </label>
        <button type="submit" class="rounded-md bg-sci px-6 py-3 font-medium text-white transition-colors hover:bg-sci-dark">Send SMS</button>
        <p id="sms-status" class="text-[15px]" role="status"></p>
      </form>
    </div>
  </section>

  <script>
    const form = document.getElementById('sms-form') as HTMLFormElement | null;
    const status = document.getElementById('sms-status') as HTMLElement | null;
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!status) return;
      const data = new FormData(form);
      status.textContent = 'Sending…';
      try {
        const res = await fetch('/api/sms-test', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            firstName: data.get('firstName'),
            lastName: data.get('lastName'),
            phone: data.get('phone'),
            consent: data.get('consent') === 'on',
          }),
        });
        const json = await res.json();
        status.textContent = json.message;
      } catch {
        status.textContent = 'Something went wrong. Please try again.';
      }
    });
  </script>
  <Footer />
</Layout>
