---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const pageTitle = 'Privacy Policy | Renata Horvat';
const pageDescription = 'Privacy Policy for renatahorvat.com - Learn how we collect, use, and protect your personal information.';
const lastUpdated = 'October 9, 2026';
---

<Layout title={pageTitle} description={pageDescription}>
  <Header />
  <div class="py-14 sm:py-16">
    <div class="max-w-4xl mx-auto px-6">
      <!-- Header -->
      <div class="mb-12">
        <h1 class="font-serif text-4xl font-medium text-ink sm:text-5xl mb-4">
          Privacy Policy
        </h1>
        <p class="text-ink-soft text-sm">
          Last Updated: <span class="text-sci">{lastUpdated}</span>
        </p>
      </div>

      <!-- Content -->
      <div class="max-w-none">
        <div class="bg-surface border border-rule rounded-lg p-8 mb-8">
          <p class="text-ink-soft leading-relaxed mb-0">
            This Privacy Policy explains how CreativeStar, IT services, owned by Renata Horvat ("we", "us", "our") collects, uses, and protects personal data when you visit or use this website.
          </p>
          <p class="text-ink-soft leading-relaxed mt-4 mb-0">
            We are committed to protecting your privacy and processing personal data in accordance with Regulation (EU) 2016/679 (General Data Protection Regulation – GDPR) and the Croatian Act on the Implementation of the General Data Protection Regulation.
          </p>
        </div>

        <!-- 1. Data Controller -->
        <section class="mb-12">
          <h2 class="font-serif text-2xl font-medium text-ink mb-4 flex items-baseline gap-3">
            <span class="font-mono text-sm text-sci">1.</span>
            Data Controller
          </h2>
          <div class="bg-surface border border-rule rounded-xl p-6">
            <p class="text-ink-soft leading-relaxed mb-4">
              <strong class="text-ink">Data Controller:</strong> Renata Horvat, trading as CreativeStar
            </p>
            <div class="space-y-2 text-ink-soft mb-4">
              <p>Address: Josipa Pupačića 4, 10090 Zagreb, Croatia</p>
              <p>OIB: 04904111520</p>
              <p>Email: <a href="mailto:screatives.info@gmail.com" class="text-sci hover:text-sci-dark">screatives.info@gmail.com</a></p>
            </div>
            <p class="text-ink-soft leading-relaxed mb-0">
              For privacy questions or requests, please use the email address above. The contact form requires a name, email address and message so that we can respond. You can also contact us by email. Please do not include sensitive personal information that is unnecessary for your enquiry.
            </p>
          </div>
        </section>

        <!-- 2. Personal Data We Collect -->
        <section class="mb-12">
          <h2 class="font-serif text-2xl font-medium text-ink mb-4 flex items-baseline gap-3">
            <span class="font-mono text-sm text-sci">2.</span>
            Personal Data We Collect
          </h2>
          <div class="bg-surface border border-rule rounded-xl p-6">
            <p class="text-ink-soft leading-relaxed mb-4">
              We may collect the following categories of personal data:
            </p>

            <!-- Data you provide directly -->
            <div class="mb-6">
              <h3 class="text-lg font-semibold text-ink mb-3">a) Data you provide directly</h3>
              <ul class="list-disc list-inside text-ink-soft space-y-2 ml-4">
                <li>Name and surname</li>
                <li>Email address</li>
                <li>Your selected project type, message and any other information you send through the contact form or by email.</li>
              </ul>
            </div>

            <!-- Data collected automatically -->
            <div>
              <h3 class="text-lg font-semibold text-ink mb-3">b) Data collected automatically</h3>
              <ul class="list-disc list-inside text-ink-soft space-y-2 ml-4">
                <li>IP address and technical request information processed by hosting providers</li>
                <li>Browser type and version</li>
                <li>Device information</li>
                <li>Pages visited and time spent on the website</li>
                <li>Referring URL</li>
              </ul>
              <p class="text-ink-soft leading-relaxed mt-3 text-sm">
                Hosting services process technical information to deliver and secure the website. Fonts are served from this website and do not generate requests to Google Fonts. Optional Google Analytics collects usage information only after you accept analytics cookies. Vercel Speed Insights measures website performance using anonymous metrics.
              </p>
            </div>
          </div>
        </section>

        <!-- 3. Purposes of Processing -->
        <section class="mb-12">
          <h2 class="font-serif text-2xl font-medium text-ink mb-4 flex items-baseline gap-3">
            <span class="font-mono text-sm text-sci">3.</span>
            Purposes of Processing
          </h2>
          <div class="bg-surface border border-rule rounded-xl p-6">
            <p class="text-ink-soft leading-relaxed mb-4">
              We process personal data for the following purposes:
            </p>
            <ul class="list-disc list-inside text-ink-soft space-y-2 ml-4">
              <li>Responding to enquiries and communication requests.</li>
              <li>Providing requested information or services (quotes, project consultations).</li>
              <li>Improving website performance and user experience.</li>
              <li>Website security and technical maintenance.</li>
              <li>Statistical analysis (where consent has been given).</li>
            </ul>
          </div>
        </section>

        <!-- 4. Legal Basis for Processing -->
        <section class="mb-12">
          <h2 class="font-serif text-2xl font-medium text-ink mb-4 flex items-baseline gap-3">
            <span class="font-mono text-sm text-sci">4.</span>
            Legal Basis for Processing
          </h2>
          <div class="bg-surface border border-rule rounded-xl p-6">
            <p class="text-ink-soft leading-relaxed mb-4">
              Personal data is processed on one or more of the following legal bases:
            </p>
            <ul class="list-disc list-inside text-ink-soft space-y-2 ml-4">
              <li><strong class="text-ink">Consent (Article 6(1)(a) GDPR)</strong> – for optional analytics cookies. Consent can be withdrawn in Cookie Settings.</li>
              <li><strong class="text-ink">Contractual necessity (Article 6(1)(b) GDPR)</strong> – to prepare a quote or take other steps you request before entering into a contract, and to provide agreed services.</li>
              <li><strong class="text-ink">Legitimate interests (Article 6(1)(f) GDPR)</strong> – to respond to general enquiries and maintain a secure, reliable website. You may object to processing based on these interests.</li>
              <li><strong class="text-ink">Legal obligations (Article 6(1)(c) GDPR)</strong> – to keep required tax records and handle consumer complaints. Confirming that you have read this policy is not consent to analytics or marketing.</li>
            </ul>
          </div>
        </section>

        <!-- 5. Data Retention -->
        <section class="mb-12">
          <h2 class="font-serif text-2xl font-medium text-ink mb-4 flex items-baseline gap-3">
            <span class="font-mono text-sm text-sci">5.</span>
            Data Retention
          </h2>
          <div class="bg-surface border border-rule rounded-xl p-6">
            <p class="text-ink-soft leading-relaxed mb-4">
              We retain personal data only for as long as necessary:
            </p>
            <ul class="list-disc list-inside text-ink-soft space-y-2 ml-4">
              <li><strong class="text-ink">Enquiries via contact form/email:</strong> up to 12 months after the last communication, unless a business relationship is established.</li>
              <li><strong class="text-ink">Invoices and tax records:</strong> for the retention period required by applicable Croatian tax legislation, including the General Tax Act. The period depends on the document and the statutory starting date; records are kept longer where a specific law requires it.</li>
              <li><strong class="text-ink">Consumer complaints:</strong> one year from receipt, as required by Croatian consumer protection law.</li>
              <li><strong class="text-ink">Analytics data:</strong> according to the Google Analytics property's configured retention period. Standard GA4 user and event data retention settings are 2 or 14 months; aggregated reports may be retained longer.</li>
            </ul>
          </div>
        </section>

        <!-- 6. Recipients of Personal Data -->
        <section class="mb-12">
          <h2 class="font-serif text-2xl font-medium text-ink mb-4 flex items-baseline gap-3">
            <span class="font-mono text-sm text-sci">6.</span>
            Recipients of Personal Data
          </h2>
          <div class="bg-surface border border-rule rounded-xl p-6">
            <p class="text-ink-soft leading-relaxed mb-4">
              We use the following providers to operate the website and handle enquiries. Depending on the service and data involved, a provider may act as a processor or an independent controller:
            </p>
            <ul class="list-disc list-inside text-ink-soft space-y-2 ml-4">
              <li><strong class="text-ink">Vercel:</strong> website hosting, request processing and anonymous performance monitoring through Speed Insights.</li>
              <li><strong class="text-ink">Resend:</strong> delivery of contact form messages, including your name, email address and message.</li>
              <li><strong class="text-ink">Google:</strong> email handling through Gmail and optional Google Analytics 4 after analytics consent.</li>
              <li>Legal authorities, if required by applicable law.</li>
            </ul>
            <p class="text-ink-soft leading-relaxed mt-4 mb-0">
              We do not sell, rent or trade your personal data. If you choose to contact us through WhatsApp, that service processes data under its own privacy terms. External project links take you to websites operated by others.
            </p>
          </div>
        </section>

        <!-- 7. Cookies and Analytics -->
        <section class="mb-12">
          <h2 class="font-serif text-2xl font-medium text-ink mb-4 flex items-baseline gap-3">
            <span class="font-mono text-sm text-sci">7.</span>
            Cookies and Analytics
          </h2>
          <div class="bg-surface border border-rule rounded-xl p-6">
            <p class="text-ink-soft leading-relaxed mb-4">
              This website stores your cookie choices in your browser and uses optional cookies to analyse website usage.
            </p>
            <ul class="list-disc list-inside text-ink-soft space-y-2 ml-4 mb-4">
              <li><strong class="text-ink">Essential storage:</strong> your preferences are saved in your browser’s local storage. This records your choice and its date; it does not require analytics consent and remains until changed or cleared.</li>
              <li><strong class="text-ink">Analytics cookies:</strong> Google Analytics 4 is loaded only after you opt in. It uses cookies such as <code>_ga</code> and <code>_ga_*</code> to distinguish visits and analyse usage. GA4 does not log or store individual IP addresses; this does not mean that hosting or other providers never process an IP address.</li>
            </ul>
            <p class="text-ink-soft leading-relaxed mb-0">
              You can change or withdraw analytics consent at any time by opening Cookie Settings using the settings button or the footer link. Rejecting analytics does not prevent you from using the website or contacting us. You can also clear stored cookies and preferences in your browser.
            </p>
          </div>
        </section>

        <!-- 8. Transfers Outside the EU -->
        <section class="mb-12">
          <h2 class="font-serif text-2xl font-medium text-ink mb-4 flex items-baseline gap-3">
            <span class="font-mono text-sm text-sci">8.</span>
            Transfers Outside the EU
          </h2>
          <div class="bg-surface border border-rule rounded-xl p-6">
            <p class="text-ink-soft leading-relaxed mb-4">
              Our providers may process data outside the European Economic Area, including in the United States. Where required, transfers are governed by applicable safeguards, such as an adequacy decision covering the recipient or European Commission Standard Contractual Clauses and any necessary supplementary measures. Contact us for information about the safeguards relevant to your data.
            </p>
          </div>
        </section>

        <!-- 9. Your Rights -->
        <section class="mb-12">
          <h2 class="font-serif text-2xl font-medium text-ink mb-4 flex items-baseline gap-3">
            <span class="font-mono text-sm text-sci">9.</span>
            Your Rights
          </h2>
          <div class="bg-surface border border-rule rounded-xl p-6">
            <p class="text-ink-soft leading-relaxed mb-4">
              Under the GDPR, you have the following rights, subject to the conditions and exceptions applicable to each right:
            </p>
            <ul class="list-disc list-inside text-ink-soft space-y-2 ml-4">
              <li>Right of access — obtain confirmation of whether your data is being processed and receive a copy.</li>
              <li>Right to rectification — request correction of inaccurate or incomplete data.</li>
              <li>Right to erasure ("right to be forgotten") — request deletion of your data where no legal obligation requires retention.</li>
              <li>Right to restriction of processing — request that processing be limited in certain circumstances.</li>
              <li>Right to data portability — receive your data in a structured, machine-readable format.</li>
              <li>Right to object — object to processing based on legitimate interest (Art. 21 GDPR).</li>
              <li>Right to withdraw consent at any time, without affecting the lawfulness of prior processing.</li>
            </ul>
            <div class="mt-6 p-4 bg-sci-soft border border-sci/30 rounded-lg">
              <p class="text-ink-soft text-sm mb-4">
                We normally respond to data protection requests within one month. Where the GDPR permits an extension, we will notify you within that month and explain the reasons. To exercise your rights, contact us at:
                <a href="mailto:screatives.info@gmail.com" class="text-sci hover:text-sci-dark font-semibold">screatives.info@gmail.com</a>
              </p>
              <p class="text-ink-soft text-sm mb-0">
                If you believe your rights have been violated, you have the right to lodge a complaint with the supervisory authority:
                <strong class="text-ink">Agencija za zaštitu osobnih podataka (AZOP)</strong><br>
                Ulica Metela Ožegovića 16, HR – 10 000 Zagreb, Croatia<br>
                Email: <a href="mailto:azop@azop.hr" class="text-sci hover:text-sci-dark">azop@azop.hr</a><br>
                Web: <a href="https://www.azop.hr" target="_blank" rel="noopener noreferrer" class="text-sci hover:text-sci-dark">www.azop.hr</a>
              </p>
            </div>
          </div>
        </section>

        <!-- 10. Data Security -->
        <section class="mb-12">
          <h2 class="font-serif text-2xl font-medium text-ink mb-4 flex items-baseline gap-3">
            <span class="font-mono text-sm text-sci">10.</span>
            Data Security
          </h2>
          <div class="bg-surface border border-rule rounded-xl p-6">
            <p class="text-ink-soft leading-relaxed mb-4">
              We apply appropriate technical and organisational measures to protect your data. While we strive for maximum security, no method of transmission over the internet is 100% secure.
            </p>
          </div>
        </section>

        <!-- 11. Changes to This Privacy Policy -->
        <section class="mb-12">
          <h2 class="font-serif text-2xl font-medium text-ink mb-4 flex items-baseline gap-3">
            <span class="font-mono text-sm text-sci">11.</span>
            Changes to This Privacy Policy
          </h2>
          <div class="bg-surface border border-rule rounded-xl p-6">
            <p class="text-ink-soft leading-relaxed mb-4">
              We reserve the right to update this policy. Any changes will be published on this page with an updated revision date.
            </p>
          </div>
        </section>

        <!-- Bottom CTA -->
        <div class="mt-12 text-center">
          <a
            href="/contact"
            class="inline-flex items-center gap-2 rounded-md bg-sci px-6 py-3 font-medium text-white transition-colors hover:bg-sci-dark"
          >
            Questions? Get in touch
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
  <Footer />
</Layout>

<style>
  .prose {
    max-width: none;
  }

  .prose h2 {
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .prose p {
    margin-bottom: 1rem;
  }

  .prose ul {
    margin-top: 0.5rem;
    margin-bottom: 1rem;
  }

  .prose li {
    margin-bottom: 0.5rem;
  }
</style>
