---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// English counterpart of src/pages/hr/privacy-policy.astro. When one version changes, update the other.
const pageTitle = 'Privacy Policy | Renata Horvat';
const pageDescription = 'Privacy Policy for renatahorvat.com — how I collect, use and protect your personal data.';
const lastUpdated = '26 October 2026';
---

<Layout title={pageTitle} description={pageDescription}>
  <Header />
  <div class="py-14 sm:py-16">
    <div class="max-w-4xl mx-auto px-6">
      <div class="mb-12">
        <h1 class="font-serif text-4xl font-medium text-ink sm:text-5xl mb-4">
          Privacy Policy
        </h1>
        <p class="text-ink-soft text-sm">
          Last updated: <span class="text-sci">{lastUpdated}</span>
        </p>
      </div>

      <div class="max-w-none">
        <div class="bg-surface border border-rule rounded-lg p-8 mb-8">
          <p class="text-ink-soft leading-relaxed mb-0">
            This Privacy Policy explains how I collect, use and protect personal data when you visit renatahorvat.com or contact me through the contact form, project questionnaire, email or WhatsApp.
          </p>
          <p class="text-ink-soft leading-relaxed mt-4 mb-0">
            I process personal data in accordance with the General Data Protection Regulation (GDPR) and applicable Croatian legislation.
          </p>
        </div>

        <section class="mb-12">
          <h2 class="font-serif text-2xl font-medium text-ink mb-4 flex items-baseline gap-3">
            <span class="font-mono text-sm text-sci">1.</span>
            Data controller
          </h2>
          <div class="bg-surface border border-rule rounded-xl p-6">
            <p class="text-ink-soft leading-relaxed mb-4">
              The data controller is <strong class="text-ink">Renata Horvat, owner of CreativeStar, obrt za računalne usluge</strong>, a Croatian sole proprietorship providing computer services.
            </p>
            <div class="space-y-2 text-ink-soft mb-4">
              <p><strong class="text-ink">Address:</strong> Josipa Pupačića 4, 10090 Zagreb, Croatia</p>
              <p><strong class="text-ink">Croatian personal identification number (OIB):</strong> 04904111520</p>
              <p>
                <strong class="text-ink">Email:</strong>
                <a href="mailto:screatives.info@gmail.com" class="text-sci hover:text-sci-dark">screatives.info@gmail.com</a>
              </p>
            </div>
            <p class="text-ink-soft leading-relaxed mb-0">
              You can use this email address to ask questions about privacy or submit requests concerning your personal data.
            </p>
          </div>
        </section>

        <section class="mb-12">
          <h2 class="font-serif text-2xl font-medium text-ink mb-4 flex items-baseline gap-3">
            <span class="font-mono text-sm text-sci">2.</span>
            What data do I collect?
          </h2>
          <div class="bg-surface border border-rule rounded-xl p-6 space-y-6">
            <div>
              <h3 class="text-lg font-semibold text-ink mb-3">Information you provide</h3>
              <p class="text-ink-soft leading-relaxed mb-3">
                Through the contact form, I collect your name, email address and message.
              </p>
              <p class="text-ink-soft leading-relaxed mb-3">
                Through the project questionnaire, I collect your name, email address and answers about the type of project, its intended audience, its goals and your preferred start date. If you choose to provide them, I also collect your phone number, existing website address and any additional notes.
              </p>
              <p class="text-ink-soft leading-relaxed mb-3">
                Information submitted through both forms is delivered to me by email. Questionnaire responses are included in the message body. The website does not maintain a separate database of these enquiries.
              </p>
              <p class="text-ink-soft leading-relaxed mb-3">
                If you contact me by email or WhatsApp, I process the information you provide during that communication.
              </p>
              <p class="text-ink-soft leading-relaxed mb-3">
                Required fields are marked in the form. You cannot submit the form without completing them, and I cannot reply without appropriate contact details. Other information is optional.
              </p>
              <p class="text-ink-soft leading-relaxed mb-0">
                Please do not send sensitive personal data that is unnecessary for your enquiry.
              </p>
            </div>

            <div>
              <h3 class="text-lg font-semibold text-ink mb-3">Technical data</h3>
              <p class="text-ink-soft leading-relaxed mb-3">
                The hosting provider processes IP addresses and technical request data to deliver, maintain and protect the website.
              </p>
              <p class="text-ink-soft leading-relaxed mb-0">
                Fonts are served from this website without sending requests to Google Fonts.
              </p>
            </div>

            <div>
              <h3 class="text-lg font-semibold text-ink mb-3">Website analytics</h3>
              <p class="text-ink-soft leading-relaxed mb-0">
                If you accept analytics, Google Analytics 4 collects information about how the website is used, such as pages visited, interactions, browser and device information, and the referring page.
              </p>
            </div>

            <div>
              <h3 class="text-lg font-semibold text-ink mb-3">Performance measurement</h3>
              <p class="text-ink-soft leading-relaxed mb-0">
                I use anonymous performance metrics, such as loading times and device and browser types, to improve website speed and the user experience. Performance measurement operates independently of your choice about website analytics and is not used to associate visits with an identifiable individual.
              </p>
            </div>
          </div>
        </section>

        <section class="mb-12">
          <h2 class="font-serif text-2xl font-medium text-ink mb-4 flex items-baseline gap-3">
            <span class="font-mono text-sm text-sci">3.</span>
            Why do I use your data?
          </h2>
          <div class="bg-surface border border-rule rounded-xl p-6">
            <p class="text-ink-soft leading-relaxed mb-4">
              I use personal data to:
            </p>
            <ul class="list-disc list-inside text-ink-soft space-y-2 ml-4 mb-0">
              <li>respond to enquiries and communicate with you;</li>
              <li>understand your needs and prepare a proposal or quotation;</li>
              <li>provide agreed services;</li>
              <li>protect and maintain the website;</li>
              <li>analyse website usage with your consent;</li>
              <li>comply with legal obligations.</li>
            </ul>
          </div>
        </section>

        <section class="mb-12">
          <h2 class="font-serif text-2xl font-medium text-ink mb-4 flex items-baseline gap-3">
            <span class="font-mono text-sm text-sci">4.</span>
            Legal bases for processing
          </h2>
          <div class="bg-surface border border-rule rounded-xl p-6 space-y-6">
            <div>
              <h3 class="text-lg font-semibold text-ink mb-3">Steps before entering into a contract and performance of a contract</h3>
              <p class="text-ink-soft leading-relaxed mb-0">
                When you request a quotation or order a service as an individual, I process the data needed to respond to your request and provide the service in order to take steps at your request before entering into a contract or to perform that contract, under Article 6(1)(b) GDPR.
              </p>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-ink mb-3">Legitimate interests</h3>
              <p class="text-ink-soft leading-relaxed mb-3">
                I process the data needed to respond to general enquiries, communicate with representatives of organisations, and keep the website secure and reliable under Article 6(1)(f) GDPR.
              </p>
              <p class="text-ink-soft leading-relaxed mb-0">
                These legitimate interests are communication with interested parties, business administration and protection of the website against misuse. You have the right to object to processing based on legitimate interests.
              </p>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-ink mb-3">Consent</h3>
              <p class="text-ink-soft leading-relaxed mb-0">
                I use optional website analytics on the basis of your consent under Article 6(1)(a) GDPR. You can change your choice or withdraw consent in
                <button type="button" class="js-open-cookie-settings font-medium text-sci underline underline-offset-2 hover:text-sci-dark">Cookie Settings</button>.
              </p>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-ink mb-3">Legal obligations</h3>
              <p class="text-ink-soft leading-relaxed mb-3">
                I process data needed for statutory tax records and handling consumer complaints to comply with legal obligations under Article 6(1)(c) GDPR.
              </p>
              <p class="text-ink-soft leading-relaxed mb-0">
                Submitting an enquiry or confirming that you have read this policy does not constitute consent to analytics or marketing messages.
              </p>
            </div>
          </div>
        </section>

        <section class="mb-12">
          <h2 class="font-serif text-2xl font-medium text-ink mb-4 flex items-baseline gap-3">
            <span class="font-mono text-sm text-sci">5.</span>
            How long do I keep your data?
          </h2>
          <div class="bg-surface border border-rule rounded-xl p-6 space-y-6">
            <div>
              <h3 class="text-lg font-semibold text-ink mb-3">Enquiries and correspondence</h3>
              <p class="text-ink-soft leading-relaxed mb-0">
                I keep enquiry data and related correspondence for as long as necessary to respond and discuss possible collaboration. When the data is no longer needed for those purposes, I delete it, unless retention is necessary to comply with legal obligations or to establish, exercise or defend legal claims.
              </p>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-ink mb-3">Data relating to client projects</h3>
              <p class="text-ink-soft leading-relaxed mb-0">
                I keep data needed to provide agreed services throughout our collaboration and afterwards for as long as necessary to comply with legal obligations or to establish, exercise or defend legal claims.
              </p>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-ink mb-3">Invoices and tax records</h3>
              <p class="text-ink-soft leading-relaxed mb-0">
                I keep invoices and tax documentation for the periods required by applicable legislation, depending on the type of document.
              </p>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-ink mb-3">Consumer complaints</h3>
              <p class="text-ink-soft leading-relaxed mb-0">
                I keep records of consumer complaints for one year from receipt.
              </p>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-ink mb-3">Analytics data</h3>
              <p class="text-ink-soft leading-relaxed mb-3">
                In Google Analytics 4, event data is retained for <strong class="text-ink">2 months</strong> and user data for <strong class="text-ink">14 months</strong>. The user-data retention period resets when the user becomes active again.
              </p>
              <p class="text-ink-soft leading-relaxed mb-0">
                These periods do not apply to most standard reports based on aggregated data. The lifetime of cookies stored in your browser is governed separately.
              </p>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-ink mb-3">Service provider records</h3>
              <p class="text-ink-soft leading-relaxed mb-3">
                Under its standard retention policy, the email delivery service retains email data and delivery logs for 30 days. This period does not determine how long I keep a received message in my inbox.
              </p>
              <p class="text-ink-soft leading-relaxed mb-0">
                The retention periods for hosting logs depend on the type of log and the service plan. These logs support website operation, troubleshooting and security.
              </p>
            </div>
          </div>
        </section>

        <section class="mb-12">
          <h2 class="font-serif text-2xl font-medium text-ink mb-4 flex items-baseline gap-3">
            <span class="font-mono text-sm text-sci">6.</span>
            Who may process your data?
          </h2>
          <div class="bg-surface border border-rule rounded-xl p-6">
            <p class="text-ink-soft leading-relaxed mb-4">
              I use the following service providers to operate the website and communicate with you:
            </p>
            <ul class="list-disc list-inside text-ink-soft space-y-2 ml-4 mb-4">
              <li><strong class="text-ink">Vercel</strong> — website hosting, technical operation and performance measurement.</li>
              <li><strong class="text-ink">Resend</strong> — delivery of messages from the contact form and project questionnaire.</li>
              <li><strong class="text-ink">Google</strong> — email communication through Gmail and website analytics through Google Analytics 4 after you give consent.</li>
            </ul>
            <p class="text-ink-soft leading-relaxed mb-3">
              Depending on the service and processing purpose, providers may act as data processors or as independent data controllers for certain activities.
            </p>
            <p class="text-ink-soft leading-relaxed mb-3">
              If you contact me through WhatsApp, its provider also processes data under its own privacy policy.
            </p>
            <p class="text-ink-soft leading-relaxed mb-3">
              I may disclose data to competent authorities when required by law.
            </p>
            <p class="text-ink-soft leading-relaxed mb-3">
              I do not sell or rent personal data.
            </p>
            <p class="text-ink-soft leading-relaxed mb-0">
              External links lead to websites operated by others. Their own privacy policies apply on those websites.
            </p>
          </div>
        </section>

        <section class="mb-12">
          <h2 class="font-serif text-2xl font-medium text-ink mb-4 flex items-baseline gap-3">
            <span class="font-mono text-sm text-sci">7.</span>
            Cookies and privacy settings
          </h2>
          <div class="bg-surface border border-rule rounded-xl p-6 space-y-6">
            <p class="text-ink-soft leading-relaxed mb-0">
              Cookies are small files stored in your browser by a website. Local storage is a separate method of storing information in your browser.
            </p>

            <div>
              <h3 class="text-lg font-semibold text-ink mb-3">Remembering your choice</h3>
              <p class="text-ink-soft leading-relaxed mb-3">
                Your analytics choice and the date of that choice are saved in your browser’s local storage. This storage is used to remember your preferences and is not used for analytics.
              </p>
              <p class="text-ink-soft leading-relaxed mb-0">
                The record has no automatic expiry. You can change your choice through
                <button type="button" class="js-open-cookie-settings font-medium text-sci underline underline-offset-2 hover:text-sci-dark">Cookie Settings</button>
                or delete the record in your browser. If a new version of the consent settings is introduced, you will be asked to make a new choice.
              </p>
            </div>

            <div>
              <h3 class="text-lg font-semibold text-ink mb-3">Analytics cookies</h3>
              <p class="text-ink-soft leading-relaxed mb-4">
                Google Analytics 4 loads after you accept analytics.
              </p>
              <div class="overflow-x-auto -mx-1 px-1">
                <table class="w-full min-w-[20rem] border-collapse text-left text-sm text-ink-soft">
                  <thead>
                    <tr class="border-b border-rule">
                      <th class="py-2 pr-3 font-semibold text-ink sm:pr-4">Cookie</th>
                      <th class="py-2 pr-3 font-semibold text-ink sm:pr-4">Purpose</th>
                      <th class="py-2 font-semibold text-ink">Default lifetime according to Google’s documentation</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr class="border-b border-rule align-top">
                      <td class="py-3 pr-3 sm:pr-4"><code class="text-ink">_ga</code></td>
                      <td class="py-3 pr-3 sm:pr-4">Distinguishing browser users</td>
                      <td class="py-3">2 years</td>
                    </tr>
                    <tr class="align-top">
                      <td class="py-3 pr-3 sm:pr-4"><code class="text-ink">_ga_*</code></td>
                      <td class="py-3 pr-3 sm:pr-4">Maintaining session information</td>
                      <td class="py-3">2 years</td>
                    </tr>
                  </tbody>
                </table>
              </div>
              <p class="text-ink-soft leading-relaxed mt-4 mb-0">
                The website code does not set a custom lifetime for these cookies. Your browser may limit their actual lifetime, and you can delete them earlier.
              </p>
            </div>

            <div>
              <h3 class="text-lg font-semibold text-ink mb-3">Changing or withdrawing consent</h3>
              <p class="text-ink-soft leading-relaxed mb-3">
                You can reject analytics and continue to use the website and its forms.
              </p>
              <p class="text-ink-soft leading-relaxed mb-3">
                You can change your choice or withdraw consent through
                <button type="button" class="js-open-cookie-settings font-medium text-sci underline underline-offset-2 hover:text-sci-dark">Cookie Settings</button>
                in the footer. When you withdraw consent, analytics is disabled and the website attempts to delete the analytics cookies it can access.
              </p>
              <p class="text-ink-soft leading-relaxed mb-3">
                Withdrawing consent does not affect the lawfulness of processing carried out before withdrawal.
              </p>
              <p class="text-ink-soft leading-relaxed mb-0">
                You can also delete stored cookies and local preferences in your browser.
              </p>
            </div>
          </div>
        </section>

        <section class="mb-12">
          <h2 class="font-serif text-2xl font-medium text-ink mb-4 flex items-baseline gap-3">
            <span class="font-mono text-sm text-sci">8.</span>
            Transfers outside the European Economic Area
          </h2>
          <div class="bg-surface border border-rule rounded-xl p-6">
            <p class="text-ink-soft leading-relaxed mb-4">
              The service providers I use may process personal data outside the European Economic Area, including in the United States.
            </p>
            <p class="text-ink-soft leading-relaxed mb-3">
              The hosting and email delivery providers include the European Commission’s Standard Contractual Clauses in their data processing terms for transfers to which those clauses apply.
            </p>
            <p class="text-ink-soft leading-relaxed mb-4">
              Google’s international transfer policies refer to adequacy decisions, including the EU–US Data Privacy Framework for covered transfers, and Standard Contractual Clauses where required.
            </p>
            <p class="text-ink-soft leading-relaxed mb-0">
              For information about applicable safeguards and how to obtain a copy, please email me at
              <a href="mailto:screatives.info@gmail.com" class="text-sci hover:text-sci-dark">screatives.info@gmail.com</a>.
            </p>
          </div>
        </section>

        <section class="mb-12">
          <h2 class="font-serif text-2xl font-medium text-ink mb-4 flex items-baseline gap-3">
            <span class="font-mono text-sm text-sci">9.</span>
            Your rights
          </h2>
          <div class="bg-surface border border-rule rounded-xl p-6">
            <p class="text-ink-soft leading-relaxed mb-4">
              Depending on the legal basis and circumstances of processing, you have the right to:
            </p>
            <ul class="list-disc list-inside text-ink-soft space-y-2 ml-4 mb-4">
              <li>request access to your personal data and a copy of it;</li>
              <li>request correction of inaccurate data or completion of incomplete data;</li>
              <li>request deletion where the applicable conditions are met;</li>
              <li>request restriction of processing;</li>
              <li>exercise your right to data portability where the applicable conditions are met;</li>
              <li>object to processing based on legitimate interests;</li>
              <li>withdraw consent for processing based on consent.</li>
            </ul>
            <p class="text-ink-soft leading-relaxed mb-4">
              These rights are subject to legal conditions and exceptions. For example, I may need to retain certain data to comply with legal obligations.
            </p>
            <p class="text-ink-soft leading-relaxed mb-4">
              You can send a request to
              <a href="mailto:screatives.info@gmail.com" class="text-sci hover:text-sci-dark">screatives.info@gmail.com</a>.
            </p>
            <p class="text-ink-soft leading-relaxed mb-4">
              I respond without undue delay and no later than one month after receiving your request. If a legally permitted extension is necessary because of the complexity or number of requests, I will notify you within the first month and explain the reasons.
            </p>
            <div class="p-4 bg-sci-soft border border-sci/30 rounded-lg">
              <p class="text-ink-soft text-sm mb-0">
                If you believe that your personal data is being processed contrary to applicable legislation, you can lodge a complaint with the supervisory authority:
                <br /><br />
                <strong class="text-ink">Croatian Personal Data Protection Agency (AZOP)</strong><br />
                Ulica Metela Ožegovića 16, 10000 Zagreb, Croatia<br />
                Email: <a href="mailto:azop@azop.hr" class="text-sci hover:text-sci-dark">azop@azop.hr</a><br />
                Website: <a href="https://azop.hr/" target="_blank" rel="noopener noreferrer" class="text-sci hover:text-sci-dark">https://azop.hr/</a>
              </p>
            </div>
          </div>
        </section>

        <section class="mb-12">
          <h2 class="font-serif text-2xl font-medium text-ink mb-4 flex items-baseline gap-3">
            <span class="font-mono text-sm text-sci">10.</span>
            Data security
          </h2>
          <div class="bg-surface border border-rule rounded-xl p-6">
            <p class="text-ink-soft leading-relaxed mb-3">
              I apply appropriate technical and organisational measures to protect personal data against unauthorised access, loss, alteration and misuse.
            </p>
            <p class="text-ink-soft leading-relaxed mb-0">
              No method of internet transmission or electronic storage can guarantee complete security.
            </p>
          </div>
        </section>

        <section class="mb-12">
          <h2 class="font-serif text-2xl font-medium text-ink mb-4 flex items-baseline gap-3">
            <span class="font-mono text-sm text-sci">11.</span>
            Changes to this Privacy Policy
          </h2>
          <div class="bg-surface border border-rule rounded-xl p-6">
            <p class="text-ink-soft leading-relaxed mb-3">
              I update this policy when processing activities, service providers or applicable requirements change.
            </p>
            <p class="text-ink-soft leading-relaxed mb-0">
              The current version and its last-updated date are available on this page.
            </p>
          </div>
        </section>

        <section class="mb-12">
          <h2 class="font-serif text-2xl font-medium text-ink mb-4 flex items-baseline gap-3">
            <span class="font-mono text-sm text-sci">12.</span>
            Business details
          </h2>
          <div class="bg-surface border border-rule rounded-xl p-6">
            <div class="space-y-4 text-ink-soft">
              <div class="flex flex-col gap-2 sm:flex-row sm:items-start">
                <strong class="min-w-[200px] text-ink">Business name:</strong>
                <span>CreativeStar obrt za računalne usluge, vl. Renata Horvat, Zagreb, Josipa Pupačića 4</span>
              </div>
              <div class="flex flex-col gap-2 sm:flex-row sm:items-start">
                <strong class="min-w-[200px] text-ink">Owner:</strong>
                <span>Renata Horvat</span>
              </div>
              <div class="flex flex-col gap-2 sm:flex-row sm:items-start">
                <strong class="min-w-[200px] text-ink">Registered address:</strong>
                <span>Josipa Pupačića 4, 10090 Zagreb, Croatia</span>
              </div>
              <div class="flex flex-col gap-2 sm:flex-row sm:items-start">
                <strong class="min-w-[200px] text-ink">Croatian personal identification number (OIB):</strong>
                <span>04904111520</span>
              </div>
              <div class="flex flex-col gap-2 sm:flex-row sm:items-start">
                <strong class="min-w-[200px] text-ink">Register:</strong>
                <span>Croatian Crafts Register (Obrtni registar)</span>
              </div>
              <div class="flex flex-col gap-2 sm:flex-row sm:items-start">
                <strong class="min-w-[200px] text-ink">Craft registration number (MBO):</strong>
                <span>99173433</span>
              </div>
              <div class="flex flex-col gap-2 sm:flex-row sm:items-start">
                <strong class="min-w-[200px] text-ink">Email:</strong>
                <a href="mailto:screatives.info@gmail.com" class="text-sci transition-colors duration-300 hover:text-sci-dark">
                  screatives.info@gmail.com
                </a>
              </div>
            </div>
          </div>
        </section>

        <div class="mt-12 text-center">
          <a
            href="/contact"
            class="inline-flex items-center gap-2 rounded-md bg-sci px-6 py-3 font-medium text-white transition-colors hover:bg-sci-dark"
          >
            Questions? Get in touch
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
  <Footer />
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.js-open-cookie-settings').forEach((el) => {
      el.addEventListener('click', () => {
        document.getElementById('footer-cookie-settings')?.click();
      });
    });
  });
</script>
