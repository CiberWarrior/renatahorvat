---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactCta from '../components/ContactCta.astro';

const pageTitle = "Pricing – Renata Horvat | Web Design Zagreb";
const pageDescription = "Starting prices for websites from €500: research project pages, society and group websites and institutional sites. Conferences, e-textbooks and science figures are quoted after a first call. Zagreb, Croatia.";
const pageKeywords = "academic website pricing, scientific society website cost, conference website price, e-learning platform price, research project website, web design pricing Croatia, website cost Zagreb";

// Each package has a defined scope (pages, rounds of changes), so the price stays predictable
const packages = [
  {
    name: 'Research project page',
    price: '€500',
    for: 'A single page for a research project, grant or lab.',
    pages: '1 page',
    cta: 'pricing_project_page',
  },
  {
    name: 'Society or research group website',
    price: '€1,000',
    for: 'A multi-page site for a scientific society or research group.',
    pages: 'Up to 5 pages',
    cta: 'pricing_society',
    common: true,
  },
  {
    name: 'Department or institutional website',
    price: '€1,800',
    for: 'A larger site with several audiences.',
    pages: 'Up to 10 pages',
    cta: 'pricing_institutional',
  },
];

// true = included, false = not included. Larger packages include everything in the smaller ones.
const rows: { label: string; values: (string | boolean)[] }[] = [
  { label: 'Pages', values: ['1', 'Up to 5', 'Up to 10'] },
  { label: 'Rounds of design changes', values: ['2', '2', '2'] },
  { label: 'Contact form', values: [true, true, true] },
  { label: 'Funder logos and acknowledgements', values: [true, true, true] },
  { label: 'Custom domain setup', values: [true, true, true] },
  { label: 'Content your team can update', values: [false, true, true] },
  { label: 'News and events', values: [false, true, true] },
  { label: 'Membership information and forms', values: [false, true, true] },
  { label: 'Publication lists', values: [false, true, true] },
  { label: 'Content structure for several audiences', values: [false, false, true] },
  { label: 'Analytics with event tracking', values: [false, false, true] },
  { label: 'Schema markup for search engines', values: [false, false, true] },
];

const scoped = [
  {
    name: 'Conference & congress websites',
    text: 'Programme, speakers, registration and abstract submission.',
    factors: ['Registration and online payment', 'Abstract submission and review', 'Size of the programme and number of speakers', 'Number of languages', 'Archive after the event'],
  },
  {
    name: 'E-textbooks & e-learning',
    text: 'Online course material with clear navigation, quizzes and diagrams.',
    factors: ['Number of chapters and amount of material', 'Number of figures and diagrams', 'Quizzes and other interactive parts', 'Moving existing content online'],
  },
  {
    name: 'Science figures & infographics',
    text: 'Diagrams for papers, posters, lectures and textbooks.',
    factors: ['Number of figures', 'Simple diagram or detailed illustration', 'Delivery formats for print and web'],
  },
];

const afterLaunch = [
  'Content and software updates',
  'Hosting and domain help',
  'Design-only work for teams that already have a developer',
];

const steps = [
  { title: 'Free first call', text: 'We talk through what you need. No brief and no commitment required.' },
  { title: 'Written quote', text: 'You get a tailored quote with the scope and the price, so you can compare it and plan your budget.' },
  { title: 'Build and handover', text: 'I build the site and hand it over so your team can keep it up to date.' },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
>
  <Header />

  <!-- Intro -->
  <section class="border-b border-rule py-14 sm:py-16">
    <div class="mx-auto max-w-6xl space-y-5 px-4 sm:px-6">
      <p class="font-mono text-xs uppercase tracking-[.08em] text-ink-soft">Pricing</p>
      <h1 class="max-w-3xl font-serif text-4xl font-medium leading-tight text-balance text-ink sm:text-5xl">
        Starting prices for websites
      </h1>
      <p class="max-w-2xl text-lg leading-relaxed text-ink-soft">
        Every project is different. The three packages below show where prices start for professional, business and institutional clients. Each has a defined scope, and larger projects get a tailored quote after our first call.
      </p>
    </div>
  </section>

  <!-- Packages -->
  <section class="py-14 sm:py-16" aria-labelledby="packages-heading">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 id="packages-heading" class="sr-only">Website packages</h2>
      <div class="grid gap-10 border-t border-ink pt-8 md:grid-cols-3 md:gap-0">
        {packages.map((pkg, i) => (
          <article class={`flex min-w-0 flex-col gap-3 ${i > 0 ? 'md:border-l md:border-rule md:pl-8' : ''} ${i < packages.length - 1 ? 'md:pr-8' : ''}`}>
            <div class={`min-h-6 items-center ${pkg.common ? 'flex' : 'hidden md:flex'}`}>
              {pkg.common && (
                <span class="rounded-full bg-sci-soft px-2.5 py-0.5 font-mono text-[11px] uppercase tracking-[.06em] text-sci">Most common</span>
              )}
            </div>
            <h3 class="font-serif text-2xl font-medium leading-tight text-ink md:min-h-[3.5rem]">{pkg.name}</h3>
            <p class="text-[15px] text-ink-soft md:min-h-[3rem]">{pkg.for}</p>
            <p class="font-serif text-4xl text-ink">
              <span class="font-text text-base text-ink-soft">from </span>{pkg.price}
            </p>
            <p class="font-mono text-xs uppercase tracking-[.06em] text-sci md:min-h-8">{pkg.pages} · 2 rounds of changes</p>
            <a
              href="/contact"
              class={`group mt-3 inline-flex items-center justify-center gap-2 rounded-md px-5 py-2.5 font-medium transition-colors ${pkg.common ? 'bg-sci text-white hover:bg-sci-dark' : 'border border-rule bg-surface text-ink hover:border-sci'}`}
              onclick={`if(typeof window.gtag !== 'undefined') window.gtag('event', 'cta_click', { cta_type: '${pkg.cta}', cta_location: 'prices_page' })`}
            >
              Ask for a quote <span class="inline-block transition-transform duration-300 group-hover:translate-x-1 motion-reduce:transition-none" aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Comparison -->
  <section class="border-t border-rule py-14 sm:py-16" aria-labelledby="compare-heading">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 id="compare-heading" class="mb-8 font-serif text-3xl font-medium text-ink sm:text-4xl">What is in each package</h2>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[560px] border-collapse text-left text-[15px]">
          <thead>
            <tr class="border-b border-ink">
              <th scope="col" class="py-3 pr-4 font-mono text-[11px] font-normal uppercase tracking-[.08em] text-ink-soft"><span class="sr-only">Feature</span></th>
              {packages.map((pkg) => (
                <th scope="col" class="px-3 py-3 font-serif text-base font-medium text-ink">{pkg.name}<span class="mt-0.5 block font-text text-sm font-normal text-ink-soft">from {pkg.price}</span></th>
              ))}
            </tr>
          </thead>
          <tbody>
            {rows.map((row) => (
              <tr class="border-b border-rule">
                <th scope="row" class="py-3 pr-4 font-normal text-ink">{row.label}</th>
                {row.values.map((v) => (
                  <td class="px-3 py-3">
                    {typeof v === 'string' ? (
                      <span class="text-ink">{v}</span>
                    ) : v ? (
                      <span class="text-sci" aria-label="Included">✓</span>
                    ) : (
                      <span class="text-ink-soft/50" aria-label="Not included">–</span>
                    )}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-6 text-[15px] text-ink-soft">
        Every project also includes a free first consultation, WCAG 2.1 AA accessibility and a fast, mobile-first build. Anything beyond the scope of a package is quoted separately. Prices in EUR, VAT not included.
      </p>
    </div>
  </section>

  <!-- Priced by scope -->
  <section class="border-t border-rule py-14 sm:py-16" aria-labelledby="scoped-heading">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="mb-8 max-w-2xl space-y-3">
        <h2 id="scoped-heading" class="font-serif text-3xl font-medium text-ink sm:text-4xl">Priced by scope</h2>
        <p class="text-ink-soft">These projects vary too much for a fixed starting price. The price depends on the points below, and I'll send a quote once I know what you need.</p>
      </div>
      <div class="grid border-t border-ink md:grid-cols-3">
        {scoped.map((item, i) => (
          <div class={`grid min-w-0 content-start gap-3 border-b border-rule py-6 md:border-b-0 ${i > 0 ? 'md:border-l md:border-rule md:pl-8' : ''} ${i < scoped.length - 1 ? 'md:pr-8' : ''}`}>
            <h3 class="font-serif text-xl font-medium text-ink">{item.name}</h3>
            <p class="text-[15px] leading-relaxed text-ink-soft">{item.text}</p>
            <div>
              <p class="mb-1.5 font-mono text-[11px] uppercase tracking-[.08em] text-ink-soft">The price depends on</p>
              <ul class="list-disc space-y-1 pl-5 text-[15px] text-ink marker:text-sci">
                {item.factors.map((f) => <li>{f}</li>)}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- After launch -->
  <section class="border-t border-rule py-14 sm:py-16" aria-labelledby="after-heading">
    <div class="mx-auto grid max-w-6xl gap-6 px-4 sm:px-6 md:grid-cols-[1fr_1.2fr] md:gap-16">
      <div class="space-y-3">
        <h2 id="after-heading" class="font-serif text-3xl font-medium text-ink sm:text-4xl">After launch</h2>
        <p class="text-ink-soft">Support is priced separately and agreed with you, either as one-off help or as ongoing care.</p>
      </div>
      <ul class="list-disc space-y-2 pl-5 text-[15px] text-ink marker:text-sci md:self-center">
        {afterLaunch.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <!-- How a quote works -->
  <section class="border-t border-rule py-14 sm:py-16" aria-labelledby="steps-heading">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 id="steps-heading" class="mb-8 font-serif text-3xl font-medium text-ink sm:text-4xl">How a quote works</h2>
      <ol class="grid gap-8 border-t border-ink pt-6 md:grid-cols-3 md:gap-0">
        {steps.map((step, i) => (
          <li class={`min-w-0 ${i > 0 ? 'md:border-l md:border-rule md:pl-8' : ''} ${i < steps.length - 1 ? 'md:pr-8' : ''}`}>
            <p class="font-mono text-sm text-sci">Step {i + 1}</p>
            <h3 class="mt-1 font-serif text-xl font-medium text-ink">{step.title}</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-ink-soft">{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <ContactCta
    location="prices_bottom"
    heading="Not sure which option fits?"
    text="Most projects start with a short conversation. No commitment and no pitch deck, just a chat about what you need."
  />

  <Footer />
</Layout>
