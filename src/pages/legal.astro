---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const pageTitle = 'Legal Notice | Renata Horvat';
const pageDescription = 'Legal Notice for CreativeStar - Business information, disclaimer, and legal details.';
const lastUpdated = 'October 9, 2026';
---

<Layout title={pageTitle} description={pageDescription}>
  <Header />
  <div class="py-14 sm:py-16">
    <div class="max-w-4xl mx-auto px-6">

      <!-- Header -->
      <div class="mb-12">
        <h1 class="font-serif text-4xl font-medium text-ink sm:text-5xl mb-4">
          Legal Notice
        </h1>
        <p class="text-ink-soft text-sm">
          Last Updated: <span class="text-sci">{lastUpdated}</span>
        </p>
      </div>

      <!-- Content -->
      <div class="max-w-none">

        <!-- Intro -->
        <div class="bg-surface border border-rule rounded-lg p-8 mb-8">
          <p class="text-ink-soft leading-relaxed mb-0">
            This Legal Notice provides information about the owner and operator of this website in accordance with applicable Croatian and EU law.
          </p>
        </div>

        <!-- 1. Business Information -->
        <section class="mb-12">
          <h2 class="font-serif text-2xl font-medium text-ink mb-4 flex items-baseline gap-3">
            <span class="font-mono text-sm text-sci">1.</span>
            Business Information
          </h2>
          <div class="bg-surface border border-rule rounded-xl p-6">
            <div class="space-y-4 text-ink-soft">
              <div class="flex flex-col sm:flex-row sm:items-start gap-2">
                <strong class="text-ink min-w-[200px]">Business Name:</strong>
                <span>CreativeStar, Computer Programming and IT Services</span>
              </div>
              <div class="flex flex-col sm:flex-row sm:items-start gap-2">
                <strong class="text-ink min-w-[200px]">Owner:</strong>
                <span>Renata Horvat</span>
              </div>
              <div class="flex flex-col sm:flex-row sm:items-start gap-2">
                <strong class="text-ink min-w-[200px]">Address:</strong>
                <span>Josipa Pupačića 4, 10090 Zagreb, Croatia</span>
              </div>
              <div class="flex flex-col sm:flex-row sm:items-start gap-2">
                <strong class="text-ink min-w-[200px]">OIB (Tax ID):</strong>
                <span>04904111520</span>
              </div>
            </div>
          </div>
        </section>

        <!-- 2. Contact -->
        <section class="mb-12">
          <h2 class="font-serif text-2xl font-medium text-ink mb-4 flex items-baseline gap-3">
            <span class="font-mono text-sm text-sci">2.</span>
            Contact
          </h2>
          <div class="bg-surface border border-rule rounded-xl p-6">
            <div class="space-y-2 text-ink-soft">
              <p class="mb-0">
                <strong class="text-ink">Email: </strong>
                <a href="mailto:screatives.info@gmail.com" class="text-sci hover:text-sci-dark transition-colors duration-300">
                  screatives.info@gmail.com
                </a>
              </p>
            </div>
          </div>
        </section>

        <!-- 3. Disclaimer of Liability -->
        <section class="mb-12">
          <h2 class="font-serif text-2xl font-medium text-ink mb-4 flex items-baseline gap-3">
            <span class="font-mono text-sm text-sci">3.</span>
            Website Information
          </h2>
          <div class="bg-surface border border-rule rounded-xl p-6">
            <p class="text-ink-soft leading-relaxed mb-4">
              This website presents our services and selected work. We take care to keep its content accurate and up to date. Project scope, deliverables, fees, payment terms and timescales are confirmed in an individual written proposal or agreement.
            </p>
            <p class="text-ink-soft leading-relaxed mb-0">
              Submitting a contact enquiry does not place an order or create a service contract. Website updates do not change an existing agreement. Nothing in this notice excludes liability or statutory rights that cannot be excluded under applicable law.
            </p>
          </div>
        </section>

        <!-- 4. Copyright -->
        <section class="mb-12">
          <h2 class="font-serif text-2xl font-medium text-ink mb-4 flex items-baseline gap-3">
            <span class="font-mono text-sm text-sci">4.</span>
            Copyright
          </h2>
          <div class="bg-surface border border-rule rounded-xl p-6">
            <p class="text-ink-soft leading-relaxed mb-4">
              Unless otherwise indicated, original text, illustrations and design on this website belong to Renata Horvat / CreativeStar. Client materials, logos, photographs, fonts and other third-party content remain the property of their respective rights holders.
            </p>
            <p class="text-ink-soft leading-relaxed mb-0">
              Permission from the relevant rights holder is required for reuse, except where an applicable licence or the law permits it.
            </p>
          </div>
        </section>

        <!-- 5. External Links -->
        <section class="mb-12">
          <h2 class="font-serif text-2xl font-medium text-ink mb-4 flex items-baseline gap-3">
            <span class="font-mono text-sm text-sci">5.</span>
            External Links
          </h2>
          <div class="bg-surface border border-rule rounded-xl p-6">
            <p class="text-ink-soft leading-relaxed mb-0">
              Links to external websites are provided for reference. Their operators are responsible for their content and privacy practices. If you believe a link leads to unlawful content, please contact us so that we can review it and remove it where appropriate.
            </p>
          </div>
        </section>

        <!-- 6. Governing Law -->
        <section class="mb-12">
          <h2 class="font-serif text-2xl font-medium text-ink mb-4 flex items-baseline gap-3">
            <span class="font-mono text-sm text-sci">6.</span>
            Governing Law
          </h2>
          <div class="bg-surface border border-rule rounded-xl p-6">
            <p class="text-ink-soft leading-relaxed mb-0">
              Croatian law applies, subject to any mandatory protections available under applicable law, including consumer protections. The competent court is determined by the applicable jurisdiction rules.
            </p>
          </div>
        </section>

        <section class="mb-12" aria-labelledby="complaints-heading">
          <h2 id="complaints-heading" class="font-serif text-2xl font-medium text-ink mb-4 flex items-baseline gap-3">
            <span class="font-mono text-sm text-sci">7.</span>
            Consumer Complaints
          </h2>
          <div class="bg-surface border border-rule rounded-xl p-6">
            <p class="text-ink-soft leading-relaxed mb-4">
              Consumers can submit a written complaint by email to <a href="mailto:screatives.info@gmail.com" class="text-sci underline underline-offset-2">screatives.info@gmail.com</a> or by post to CreativeStar, Renata Horvat, Josipa Pupačića 4, 10090 Zagreb, Croatia. Please include your contact details and a description of the issue.
            </p>
            <p class="text-ink-soft leading-relaxed mb-0">
              Receipt will be acknowledged without delay. We will provide a written response within 15 days of receiving the complaint, stating whether we accept its grounds. Consumer complaint records are retained for one year from receipt, as required by Croatian law.
            </p>
          </div>
        </section>
        <section class="mb-12" aria-labelledby="consumer-contracts-heading">
          <h2 id="consumer-contracts-heading" class="font-serif text-2xl font-medium text-ink mb-4 flex items-baseline gap-3">
            <span class="font-mono text-sm text-sci">8.</span>
            Consumer Contracts
          </h2>
          <div class="bg-surface border border-rule rounded-xl p-6">
            <p class="text-ink-soft leading-relaxed mb-4">
              If you commission a service as a consumer, mandatory consumer rights apply. For service contracts concluded at a distance or outside our business premises, a 14-day withdrawal period generally applies from the date the contract is concluded, subject to statutory exceptions.
            </p>
            <p class="text-ink-soft leading-relaxed mb-0">
              Before concluding a consumer contract, we will provide the applicable terms, total price, withdrawal information and any required form in a format you can keep. Starting work during the withdrawal period requires your express request. Any payment for work completed before withdrawal, or loss of the withdrawal right after full performance, is subject to the conditions set by law. This website notice does not replace those project-specific documents.
            </p>
          </div>
        </section>


      </div>
    </div>
  </div>
  <Footer />
</Layout>

<style>
  .prose {
    max-width: none;
  }

  .prose h2 {
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .prose p {
    margin-bottom: 1rem;
  }

  .prose ul {
    margin-top: 0.5rem;
    margin-bottom: 1rem;
  }

  .prose li {
    margin-bottom: 0.5rem;
  }
</style>
