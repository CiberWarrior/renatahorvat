---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const pageTitle = 'Legal Notice | Renata Horvat';
const pageDescription = 'Legal Notice for CreativeStar - Business information, disclaimer, and legal details.';
const lastUpdated = 'March 10, 2026';
---

<Layout title={pageTitle} description={pageDescription}>
  <Header />
  <div class="py-14 sm:py-16">
    <div class="max-w-4xl mx-auto px-6">

      <!-- Header -->
      <div class="mb-12">
        <h1 class="font-serif text-4xl font-medium text-ink sm:text-5xl mb-4">
          Legal Notice
        </h1>
        <p class="text-ink-soft text-sm">
          Last Updated: <span class="text-sci">{lastUpdated}</span>
        </p>
      </div>

      <!-- Content -->
      <div class="max-w-none">

        <!-- Intro -->
        <div class="bg-surface border border-rule rounded-lg p-8 mb-8">
          <p class="text-ink-soft leading-relaxed mb-0">
            This Legal Notice provides information about the owner and operator of this website in accordance with applicable Croatian and EU law.
          </p>
        </div>

        <!-- 1. Business Information -->
        <section class="mb-12">
          <h2 class="font-serif text-2xl font-medium text-ink mb-4 flex items-baseline gap-3">
            <span class="font-mono text-sm text-sci">1.</span>
            Business Information
          </h2>
          <div class="bg-surface border border-rule rounded-xl p-6">
            <div class="space-y-4 text-ink-soft">
              <div class="flex flex-col sm:flex-row sm:items-start gap-2">
                <strong class="text-ink min-w-[200px]">Business Name:</strong>
                <span>CreativeStar, Computer Programming and IT Services</span>
              </div>
              <div class="flex flex-col sm:flex-row sm:items-start gap-2">
                <strong class="text-ink min-w-[200px]">Owner:</strong>
                <span>Renata Horvat</span>
              </div>
              <div class="flex flex-col sm:flex-row sm:items-start gap-2">
                <strong class="text-ink min-w-[200px]">Address:</strong>
                <span>Josipa Pupačića 4, 10090 Zagreb, Croatia</span>
              </div>
              <div class="flex flex-col sm:flex-row sm:items-start gap-2">
                <strong class="text-ink min-w-[200px]">OIB (Tax ID):</strong>
                <span>04904111520</span>
              </div>
            </div>
          </div>
        </section>

        <!-- 2. Contact -->
        <section class="mb-12">
          <h2 class="font-serif text-2xl font-medium text-ink mb-4 flex items-baseline gap-3">
            <span class="font-mono text-sm text-sci">2.</span>
            Contact
          </h2>
          <div class="bg-surface border border-rule rounded-xl p-6">
            <div class="space-y-2 text-ink-soft">
              <p class="mb-0">
                <strong class="text-ink">Email: </strong>
                <a href="mailto:screatives.info@gmail.com" class="text-sci hover:text-sci-dark transition-colors duration-300">
                  screatives.info@gmail.com
                </a>
              </p>
            </div>
          </div>
        </section>

        <!-- 3. Disclaimer of Liability -->
        <section class="mb-12">
          <h2 class="font-serif text-2xl font-medium text-ink mb-4 flex items-baseline gap-3">
            <span class="font-mono text-sm text-sci">3.</span>
            Disclaimer of Liability
          </h2>
          <div class="bg-surface border border-rule rounded-xl p-6">
            <p class="text-ink-soft leading-relaxed mb-4">
              The content of this website has been compiled with the greatest possible care. However, we cannot guarantee the accuracy, completeness, or timeliness of the information provided.
            </p>
            <p class="text-ink-soft leading-relaxed mb-0">
              We reserve the right to modify, supplement, or delete parts of the website or the entire website without prior notice.
            </p>
          </div>
        </section>

        <!-- 4. Copyright -->
        <section class="mb-12">
          <h2 class="font-serif text-2xl font-medium text-ink mb-4 flex items-baseline gap-3">
            <span class="font-mono text-sm text-sci">4.</span>
            Copyright
          </h2>
          <div class="bg-surface border border-rule rounded-xl p-6">
            <p class="text-ink-soft leading-relaxed mb-4">
              All content published on this website — including text, images, graphics, and design — is the intellectual property of Renata Horvat / CreativeStar and is protected by applicable copyright law.
            </p>
            <p class="text-ink-soft leading-relaxed mb-0">
              Any reproduction, distribution, or use of content from this website without prior written consent is strictly prohibited.
            </p>
          </div>
        </section>

        <!-- 5. External Links -->
        <section class="mb-12">
          <h2 class="font-serif text-2xl font-medium text-ink mb-4 flex items-baseline gap-3">
            <span class="font-mono text-sm text-sci">5.</span>
            External Links
          </h2>
          <div class="bg-surface border border-rule rounded-xl p-6">
            <p class="text-ink-soft leading-relaxed mb-0">
              This website may contain links to external websites. We have no control over the content of those websites and accept no responsibility for them. At the time of linking, the linked pages were checked for potential legal violations — no illegal content was found. We will remove any links promptly if violations are identified.
            </p>
          </div>
        </section>

        <!-- 6. Governing Law -->
        <section class="mb-12">
          <h2 class="font-serif text-2xl font-medium text-ink mb-4 flex items-baseline gap-3">
            <span class="font-mono text-sm text-sci">6.</span>
            Governing Law
          </h2>
          <div class="bg-surface border border-rule rounded-xl p-6">
            <p class="text-ink-soft leading-relaxed mb-0">
              This Legal Notice is governed by the laws of the Republic of Croatia. Any disputes arising from the use of this website shall be subject to the jurisdiction of the competent courts in Zagreb, Croatia.
            </p>
          </div>
        </section>


      </div>
    </div>
  </div>
  <Footer />
</Layout>

<style>
  .prose {
    max-width: none;
  }

  .prose h2 {
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .prose p {
    margin-bottom: 1rem;
  }

  .prose ul {
    margin-top: 0.5rem;
    margin-bottom: 1rem;
  }

  .prose li {
    margin-bottom: 0.5rem;
  }
</style>
